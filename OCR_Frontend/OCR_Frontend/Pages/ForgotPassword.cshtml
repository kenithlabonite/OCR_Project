@page
@model OCR_Frontend.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-wrapper">
    <div class="auth-container">
        <div class="glass-panel p-5">
            <div class="text-center mb-4">
                <i class="bi bi-shield-lock fs-1" style="color: var(--primary-color);"></i>
                <h2 class="mt-3">Forgot Password?</h2>
                <p>Enter your registered email — we'll send you a 6-digit reset code.</p>
            </div>

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <form method="post">
                <div class="mb-4">
                    <label class="form-label" asp-for="Email">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" placeholder="name@example.com" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-4">Send Reset Code</button>

                <div class="text-center text-muted">
                    Remembered your password? <a href="/Login" class="text-decoration-none fw-medium" style="color: var(--primary-color);">Back to Login</a>
                </div>
            </form>
        </div>
    </div>
</div>
