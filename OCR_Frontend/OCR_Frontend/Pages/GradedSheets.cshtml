@page
@model OCR_Frontend.Pages.GradedSheetsModel
@{
    ViewData["Title"] = "Graded Student Answer Sheets";
}

<div class="container mt-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Dashboard">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-page="/Questionnaires">Questionnaires</a></li>
            <li class="breadcrumb-item active" aria-current="page">Graded Student Sheets</li>
        </ol>
    </nav>

    <!-- Header Banner -->
    <div class="glass-panel p-4 mb-4 border-0 shadow-sm rounded-4 position-relative overflow-hidden bg-gradient" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(59, 130, 246, 0.1) 100%);">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-6 fw-bold mb-2" style="background: linear-gradient(to right, #059669, #2563eb); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    <i class="bi bi-file-earmark-check-fill me-2" style="-webkit-text-fill-color: #059669;"></i>Graded Student Answer Sheets
                </h1>
                <p class="text-muted fs-5 mb-0">Browse and inspect AI-graded answer sheets, student names, scores, and OCR answer breakdowns.</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <span class="badge bg-success-subtle text-success border border-success-subtle p-2 px-3 rounded-pill fs-6">
                    <i class="bi bi-check-all me-1"></i> @Model.TotalSheets Total Graded
                </span>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card glass-panel border-0 shadow-sm">
                <div class="card-body p-3 text-center">
                    <div class="text-primary fs-2 fw-bold">@Model.TotalSheets</div>
                    <small class="text-muted"><i class="bi bi-people me-1"></i>Graded Answer Sheets</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card glass-panel border-0 shadow-sm">
                <div class="card-body p-3 text-center">
                    <div class="text-success fs-2 fw-bold">@Model.AverageScore.ToString("0.0")%</div>
                    <small class="text-muted"><i class="bi bi-graph-up me-1"></i>Average Class Score</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card glass-panel border-0 shadow-sm">
                <div class="card-body p-3 text-center">
                    <div class="text-success fs-2 fw-bold">@Model.PassedCount</div>
                    <small class="text-muted"><i class="bi bi-hand-thumbs-up me-1"></i>Passed (≥50%)</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card glass-panel border-0 shadow-sm">
                <div class="card-body p-3 text-center">
                    <div class="text-danger fs-2 fw-bold">@Model.FailedCount</div>
                    <small class="text-muted"><i class="bi bi-exclamation-circle me-1"></i>Needs Review (&lt;50%)</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="card glass-panel border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" id="searchInput" class="form-control border-start-0" placeholder="Search by student name or document name..." onkeyup="filterTable()" />
                    </div>
                </div>
                <div class="col-md-6 text-md-end">
                    @if (Model.SelectedExamId.HasValue)
                    {
                        <span class="badge bg-primary-subtle text-primary me-2 p-2 px-3 rounded-pill">
                            Filtered by Exam #@Model.SelectedExamId
                        </span>
                        <a asp-page="/GradedSheets" class="btn btn-sm btn-outline-secondary">Show All Exams</a>
                    }
                    <button class="btn btn-sm btn-outline-primary" onclick="document.getElementById('searchInput').value=''; filterTable();">
                        <i class="bi bi-arrow-clockwise me-1"></i>Reset Filter
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Graded Sheets Table Card -->
    <div class="card glass-panel border-0 shadow-sm mb-5">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="card-title mb-0"><i class="bi bi-journal-check text-primary me-2"></i>Student Submissions &amp; Scores</h5>
                <span class="text-muted small">Showing @Model.GradedSheets.Count recorded test papers</span>
            </div>

            @if (!Model.GradedSheets.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 text-secondary"></i>
                    <p class="mt-2 fs-5">No graded answer sheets stored yet.</p>
                    <p class="small">Upload a student answer sheet from an exam page to start grading!</p>
                    <a asp-page="/Questionnaires" class="btn btn-primary btn-sm px-4">Go to Questionnaires</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="gradedTable">
                        <thead class="table-light">
                            <tr>
                                <th># ID</th>
                                <th>Student Name</th>
                                <th>Title / Topic</th>
                                <th class="text-center">Score</th>
                                <th class="text-center">Percentage</th>
                                <th>Graded Date</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sheet in Model.GradedSheets)
                            {
                                <tr>
                                    <td><code>#@sheet.Id</code></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                                <i class="bi bi-person-fill fs-5"></i>
                                            </div>
                                            <div>
                                                @if (!string.IsNullOrWhiteSpace(sheet.StudentName))
                                                {
                                                    <span class="fw-bold text-dark d-block">@sheet.StudentName</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted italic d-block">Anonymous Student</span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                     <td>
                                         <div class="d-flex align-items-center gap-2">
                                             <i class="bi bi-journal-bookmark-fill text-primary fs-5"></i>
                                             <span class="fw-medium text-dark">@sheet.DocumentFileName</span>
                                         </div>
                                     </td>
                                    <td class="text-center fw-bold fs-6">
                                        @sheet.CorrectCount / @sheet.TotalQuestions
                                    </td>
                                    <td class="text-center">
                                        @if (sheet.ScorePercentage >= 75)
                                        {
                                            <span class="badge bg-success px-3 py-2 fs-6 rounded-pill">
                                                <i class="bi bi-check-circle-fill me-1"></i>@sheet.ScorePercentage.ToString("0.0")%
                                            </span>
                                        }
                                        else if (sheet.ScorePercentage >= 50)
                                        {
                                            <span class="badge bg-primary px-3 py-2 fs-6 rounded-pill">
                                                <i class="bi bi-check-circle me-1"></i>@sheet.ScorePercentage.ToString("0.0")%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-3 py-2 fs-6 rounded-pill">
                                                <i class="bi bi-x-circle me-1"></i>@sheet.ScorePercentage.ToString("0.0")%
                                            </span>
                                        }
                                    </td>
                                    <td class="text-muted small">
                                        <i class="bi bi-clock me-1"></i>@sheet.GradedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-outline-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#modal-@sheet.Id">
                                            <i class="bi bi-eye me-1"></i> View Answers
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ── Modals rendered OUTSIDE the table so Bootstrap can display them properly ── *@
    @if (Model.GradedSheets.Any())
    {
        foreach (var sheet in Model.GradedSheets)
        {
            <div class="modal fade" id="modal-@sheet.Id" tabindex="-1" aria-labelledby="modalLabel-@sheet.Id" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                    <div class="modal-content glass-panel border-0 shadow-lg">
                        <div class="modal-header bg-gradient-primary text-white border-0 py-3" style="background: linear-gradient(135deg, var(--primary-color), #8b5cf6);">
                            <h5 class="modal-title fw-bold text-white" id="modalLabel-@sheet.Id">
                                <i class="bi bi-award me-2"></i>Grading Details — @(string.IsNullOrWhiteSpace(sheet.StudentName) ? "Anonymous Student" : sheet.StudentName)
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4 text-start">
                            <!-- Student Summary Header inside Modal -->
                            <div class="card bg-light border-0 mb-4 p-3 rounded-3">
                                <div class="row align-items-center">
                                    <div class="col-md-6">
                                        <p class="mb-1 text-muted small">Student Name</p>
                                        <h5 class="fw-bold mb-0 text-dark">@(string.IsNullOrWhiteSpace(sheet.StudentName) ? "Anonymous Student" : sheet.StudentName)</h5>
                                        <small class="text-muted"><i class="bi bi-journal-bookmark me-1"></i>@sheet.DocumentFileName</small>
                                    </div>
                                    <div class="col-md-6 text-md-end mt-2 mt-md-0">
                                        <span class="display-6 fw-bold text-primary">@sheet.CorrectCount / @sheet.TotalQuestions</span>
                                        <span class="d-block text-muted small">Score: <strong>@sheet.ScorePercentage.ToString("0.0")%</strong></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Item Breakdown -->
                            <h6 class="fw-bold mb-3"><i class="bi bi-list-check text-primary me-2"></i>Question Item Breakdown</h6>
                            @if (sheet.Results != null && sheet.Results.Any())
                            {
                                <div class="table-responsive mb-4">
                                    <table class="table table-bordered align-middle">
                                        <thead class="table-light text-center">
                                            <tr>
                                                <th style="width: 15%;">Item #</th>
                                                <th style="width: 35%;">Scanned Student Answer</th>
                                                <th style="width: 35%;">Correct Answer Key</th>
                                                <th style="width: 15%;">Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in sheet.Results)
                                            {
                                                <tr>
                                                    <td class="text-center fw-bold">Q@(item.QuestionNumber)</td>
                                                    <td class="text-center fs-6">
                                                        @if (!string.IsNullOrEmpty(item.ScannedAnswer))
                                                        {
                                                            <span class="badge bg-secondary-subtle text-dark border px-3 py-1">@item.ScannedAnswer</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted italic small">(No detection)</span>
                                                        }
                                                    </td>
                                                    <td class="text-center fs-6">
                                                        <span class="badge bg-primary-subtle text-primary border px-3 py-1">@item.CorrectAnswer</span>
                                                    </td>
                                                    <td class="text-center">
                                                        @if (item.IsCorrect)
                                                        {
                                                            <span class="badge bg-success-subtle text-success px-3 py-1">
                                                                <i class="bi bi-check-lg me-1"></i> Correct
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger-subtle text-danger px-3 py-1">
                                                                <i class="bi bi-x-lg me-1"></i> Incorrect
                                                            </span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            <!-- Uploaded Answer Sheet Images -->
                            @if (sheet.ImageUrls != null && sheet.ImageUrls.Any())
                            {
                                <h6 class="fw-bold mb-3 mt-4"><i class="bi bi-images text-info me-2"></i>Uploaded Answer Sheet (@sheet.ImageUrls.Count page(s))</h6>
                                <div class="d-flex flex-wrap gap-3 mb-4">
                                    @for (int i = 0; i < sheet.ImageUrls.Count; i++)
                                    {
                                        var imgUrl = sheet.ImageUrls[i];
                                        <div class="text-center">
                                            <a href="@Model.BackendBaseUrl@imgUrl" target="_blank" title="Click to view full size — Page @(i + 1)">
                                                <img src="@Model.BackendBaseUrl@imgUrl"
                                                     alt="Answer Sheet Page @(i + 1)"
                                                     class="rounded border shadow-sm"
                                                     style="max-height: 300px; max-width: 220px; object-fit: contain; cursor: zoom-in; transition: transform 0.2s;"
                                                     onmouseover="this.style.transform='scale(1.03)'"
                                                     onmouseout="this.style.transform='scale(1)'"
                                                     onerror="this.closest('.text-center').innerHTML='<span class=\'text-muted small\'><i class=\'bi bi-image-slash me-1\'></i>Page @(i+1) unavailable</span>'" />
                                            </a>
                                            <div class="small text-muted mt-1">Page @(i + 1)</div>
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Raw OCR Output -->
                            <h6 class="fw-bold mb-2"><i class="bi bi-code-square text-secondary me-2"></i>Raw OCR Extracted Text</h6>
                            <pre class="bg-dark text-light p-3 rounded-3 mb-0" style="white-space: pre-wrap; font-size: 0.85rem; max-height: 200px; overflow-y: auto;">@sheet.RawOcrText</pre>
                        </div>
                        <div class="modal-footer border-0">
                            <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        function filterTable() {
            var input = document.getElementById("searchInput");
            var filter = input.value.toLowerCase();
            var table = document.getElementById("gradedTable");
            if (!table) return;
            var tr = table.getElementsByTagName("tr");

            for (var i = 1; i < tr.length; i++) {
                var tdStudent = tr[i].getElementsByTagName("td")[1];
                var tdDoc = tr[i].getElementsByTagName("td")[2];
                if (tdStudent || tdDoc) {
                    var studentText = tdStudent ? (tdStudent.textContent || tdStudent.innerText) : "";
                    var docText = tdDoc ? (tdDoc.textContent || tdDoc.innerText) : "";
                    if (studentText.toLowerCase().indexOf(filter) > -1 || docText.toLowerCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
            }
        }
    </script>
}
