@page
@model OCR_Frontend.Pages.VerifyEmailModel
@{
    ViewData["Title"] = "Verify Email";
}

<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: calc(100vh - 40px);">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body px-4 py-4">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 44px; height: 44px; background-color: #eff6ff; border: 1.5px solid #93c5fd;">
                        <i class="bi bi-envelope-check-fill" style="font-size: 1.25rem; color: #2563eb;"></i>
                    </div>
                    <p class="text-uppercase fw-semibold mb-1" style="font-size: 0.70rem; letter-spacing: 0.08em; color: #94a3b8;">
                        EMAIL VERIFICATION
                    </p>
                    <h1 class="fw-bold mb-1" style="font-size: 1.15rem; color: #1e293b;">Verify Your Email</h1>
                    <p class="mb-0" style="font-size: 0.82rem; color: #64748b;">
                        We've sent a 4-digit verification code (OTP) to your inbox. Enter it below to activate your account.
                    </p>
                </div>

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <form method="post">
                    <div class="form-floating mb-3">
                        <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" required />
                        <label asp-for="Email">Email Address</label>
                    </div>

                    <div class="form-floating mb-1">
                        <input asp-for="Otp" type="text" maxlength="4" class="form-control font-monospace text-center fw-bold" placeholder="1234" required style="letter-spacing: 6px; font-size: 1.25rem;" />
                        <label asp-for="Otp">4-Digit Verification Code</label>
                    </div>
                    <p class="mb-4" style="font-size: 0.74rem; color: #94a3b8;">
                        Enter the 4-digit code sent to your registered email.
                    </p>

                    <button type="submit" class="btn w-100 fw-semibold btn-cc-blue mb-3" style="height: 42px; background-color: #eff6ff; border: 1.5px solid #93c5fd; color: #2563eb; border-radius: 8px; font-size: 0.82rem; letter-spacing: 0.03em;">
                        <i class="bi bi-shield-check me-1"></i> Verify Code
                    </button>

                    <div class="text-center" style="font-size: 0.80rem; color: #64748b;">
                        Didn't get the code? <a href="/Register" class="text-decoration-none fw-semibold" style="color: #2563eb;">Try Registering Again</a>
                    </div>
                </form>
            </div>
            <div style="height: 3px; background: linear-gradient(90deg, #2563eb, #60a5fa); border-radius: 0 0 0.375rem 0.375rem;"></div>
        </div>
    </div>
</div>
