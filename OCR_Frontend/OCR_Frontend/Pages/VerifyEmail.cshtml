@page
@model OCR_Frontend.Pages.VerifyEmailModel
@{
    ViewData["Title"] = "Verify Email";
}

<div class="auth-wrapper">
    <div class="auth-container">
        <div class="glass-panel p-5">
            <div class="text-center mb-4">
                <i class="bi bi-envelope-check fs-1" style="color: var(--primary-color);"></i>
                <h2 class="mt-3">Verify Your Email</h2>
                <p>We've sent a 4-digit verification code (OTP) to your email. Enter it below to activate your account.</p>
            </div>

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label" asp-for="Email">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" placeholder="name@example.com" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label" asp-for="Otp">Verification Code (OTP)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-shield-check"></i></span>
                        <input asp-for="Otp" type="text" maxlength="4" class="form-control border-start-0 ps-0" placeholder="e.g. 1234" required />
                    </div>
                    <small class="text-muted">Enter the 4-digit code from your email.</small>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-4">Verify Code</button>

                <div class="text-center text-muted">
                    Didn't get the code? <a href="/Register" class="text-decoration-none fw-medium" style="color: var(--primary-color);">Try Registering Again</a>
                </div>
            </form>
        </div>
    </div>
</div>
