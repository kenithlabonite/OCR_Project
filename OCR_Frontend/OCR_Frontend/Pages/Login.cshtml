@page
@model OCR_Frontend.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: calc(100vh - 40px);">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body px-4 py-4">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 44px; height: 44px; background-color: #eff6ff; border: 1.5px solid #93c5fd;">
                        <i class="bi bi-bezier2" style="font-size: 1.25rem; color: #2563eb;"></i>
                    </div>
                    <p class="text-uppercase fw-semibold mb-1" style="font-size: 0.70rem; letter-spacing: 0.08em; color: #94a3b8;">
                        AUTHENTICATION
                    </p>
                    <h1 class="fw-bold mb-1" style="font-size: 1.15rem; color: #1e293b;">Sign In to NexusOCR</h1>
                    <p class="mb-0" style="font-size: 0.82rem; color: #64748b;">Enter your credentials to access your workspace</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="card border-0 shadow-sm mb-3" style="background-color: #f0fdf4; border: 1.5px solid #86efac !important;">
                        <div class="card-body px-3 py-2 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2" style="color: #16a34a; font-size: 0.80rem; font-weight: 500;">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>@TempData["SuccessMessage"]</span>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="font-size: 0.70rem;"></button>
                        </div>
                    </div>
                }

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <form method="post">
                    <div class="form-floating mb-3">
                        <input asp-for="Email" type="email" class="form-control" id="Email" placeholder="name@example.com" required />
                        <label asp-for="Email">Email Address</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" type="password" class="form-control" id="Password" placeholder="••••••••" required />
                        <label asp-for="Password">Password</label>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" type="checkbox" class="form-check-input" id="rememberMe">
                            <label class="form-check-label fw-semibold" for="rememberMe" style="font-size: 0.80rem; color: #475569;">
                                Remember me
                            </label>
                        </div>
                        <a href="/ForgotPassword" class="text-decoration-none fw-semibold" style="font-size: 0.80rem; color: #2563eb;">
                            Forgot password?
                        </a>
                    </div>

                    <button type="submit" class="btn w-100 fw-semibold btn-cc-blue mb-3" style="height: 42px; background-color: #eff6ff; border: 1.5px solid #93c5fd; color: #2563eb; border-radius: 8px; font-size: 0.82rem; letter-spacing: 0.03em;">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                </form>
            </div>
            <div style="height: 3px; background: linear-gradient(90deg, #2563eb, #60a5fa); border-radius: 0 0 0.375rem 0.375rem;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const emailInput = document.getElementById("Email");
            const passwordInput = document.getElementById("Password");
            const rememberMeCheckbox = document.getElementById("rememberMe");
            const form = document.querySelector("form");

            // Client-side fallback: pre-fill remembered email from localStorage if not already rendered by server
            if (emailInput && !emailInput.value) {
                const storedEmail = localStorage.getItem("rememberedEmail");
                if (storedEmail) {
                    emailInput.value = storedEmail;
                    if (rememberMeCheckbox) rememberMeCheckbox.checked = true;
                }
            }

            // If email is already pre-filled (via cookie or localStorage), auto-focus the password field
            if (emailInput && emailInput.value && passwordInput) {
                passwordInput.focus();
            }

            // Sync with localStorage on submit
            if (form && emailInput && rememberMeCheckbox) {
                form.addEventListener("submit", function () {
                    if (rememberMeCheckbox.checked && emailInput.value.trim()) {
                        localStorage.setItem("rememberedEmail", emailInput.value.trim());
                    } else {
                        localStorage.removeItem("rememberedEmail");
                    }
                });
            }
        });
    </script>
}
