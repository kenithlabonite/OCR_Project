@page
@model OCR_Frontend.Pages.QuestionnairesModel
@{
    ViewData["Title"] = "Questionnaires";
}

<div class="container-fluid px-3 px-md-4 mt-3">

    <!-- Breadcrumb Card -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2 px-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0" style="font-size: 0.85rem;">
                    <li class="breadcrumb-item">
                        <a href="/Dashboard" class="text-decoration-none" style="color: #2563eb;">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        <span style="font-weight: 600; color: #1e293b;">Questionnaires</span>
                    </li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Page Header Card -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body px-4 py-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px; background-color: #fdf4ff;">
                        <i class="bi bi-journal-text" style="color: #9333ea; font-size: 1rem;"></i>
                    </div>
                    <div>
                        <p class="fw-bold mb-0" style="color: #1e293b; font-size: 1rem;">
                            Exam Questionnaires
                        </p>
                        <p class="mb-0" style="font-size: 0.75rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.07em;">
                            Generated Test Questionnaires &middot; QuestPDF Exports
                        </p>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <a href="/GenerateQuestionnaire" class="btn fw-semibold d-inline-flex align-items-center gap-1.5 btn-cc-purple" style="background-color: #fdf4ff; color: #9333ea; border: 1.5px solid #d8b4fe; border-radius: 8px; font-size: 0.78rem; letter-spacing: 0.03em;">
                        <i class="bi bi-magic" style="font-size: 0.90rem;"></i> Generate New Exam
                    </a>
                    <a href="/GradedSheets" class="btn fw-semibold d-inline-flex align-items-center gap-1.5 btn-cc-green" style="background-color: #f0fdf4; color: #16a34a; border: 1.5px solid #86efac; border-radius: 8px; font-size: 0.78rem; letter-spacing: 0.03em;">
                        <i class="bi bi-patch-check-fill" style="font-size: 0.90rem;"></i> Graded Sheets
                    </a>
                </div>
            </div>
        </div>
        <div style="height: 3px; background: linear-gradient(90deg, #9333ea, #a78bfa); border-radius: 0 0 0.375rem 0.375rem;"></div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="d-flex align-items-center gap-2 p-3 rounded mb-3" style="background-color: #fff1f2; border: 1.5px solid #fda4af; color: #e11d48; font-size: 0.82rem;">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <!-- Questionnaires List -->
    @if (Model.Exams.Any())
    {
        @foreach (var exam in Model.Exams)
        {
            var collapseId = "collapseExam-" + exam.ExamId;
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body px-4 py-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div>
                            <p class="text-uppercase fw-semibold mb-1" style="font-size: 0.70rem; letter-spacing: 0.08em; color: #94a3b8;">
                                <i class="bi bi-file-earmark-check me-1"></i> Exam #@exam.ExamId
                            </p>
                            <h4 class="fw-bold mb-1" style="font-size: 1.15rem; color: #1e293b;">
                                @exam.DocumentFileName
                            </h4>
                            <p class="mb-0 text-muted" style="font-size: 0.75rem;">
                                Generated @exam.GeneratedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm") &middot; @exam.Questions.Count Questions
                            </p>
                        </div>

                        <!-- Action buttons stack -->
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <button type="button" class="btn fw-semibold d-inline-flex align-items-center gap-1.5 btn-cc-neutral" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" style="background-color: #f1f5f9; color: #475569; border: 1.5px solid #e2e8f0; border-radius: 8px; font-size: 0.75rem; height: 36px;">
                                <i class="bi bi-eye"></i> View Questions
                            </button>

                            <form method="post" asp-page-handler="DownloadQuestionsPdf" class="d-inline">
                                <input type="hidden" name="id" value="@exam.ExamId" />
                                <button type="submit" class="btn fw-semibold d-inline-flex align-items-center gap-1.5 btn-cc-purple" title="Download Questionnaire without answers" style="background-color: #fdf4ff; color: #9333ea; border: 1.5px solid #d8b4fe; border-radius: 8px; font-size: 0.75rem; height: 36px;">
                                    <i class="bi bi-file-earmark-text"></i> Test Paper PDF
                                </button>
                            </form>

                            <form method="post" asp-page-handler="DownloadAnswersPdf" class="d-inline">
                                <input type="hidden" name="id" value="@exam.ExamId" />
                                <button type="submit" class="btn fw-semibold d-inline-flex align-items-center gap-1.5 btn-cc-green" title="Download Answer Key with explanations" style="background-color: #f0fdf4; color: #16a34a; border: 1.5px solid #86efac; border-radius: 8px; font-size: 0.75rem; height: 36px;">
                                    <i class="bi bi-key"></i> Answer Key PDF
                                </button>
                            </form>

                            <a href="/GradeExam?examId=@exam.ExamId" class="btn fw-semibold d-inline-flex align-items-center gap-1.5 btn-cc-blue" style="background-color: #eff6ff; color: #2563eb; border: 1.5px solid #93c5fd; border-radius: 8px; font-size: 0.75rem; height: 36px;">
                                <i class="bi bi-robot"></i> Grade Sheet
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Collapsible Details -->
                <div class="collapse" id="@collapseId">
                    <hr class="mx-3 my-0" style="border-color: #f1f5f9;">
                    <div class="px-4 py-3" style="background-color: #f8fafc;">
                        <!-- Instructions Pill Alert -->
                        <div class="d-flex align-items-center gap-2 p-3 rounded mb-3" style="background-color: #fff7ed; border: 1.5px solid #fed7aa; color: #c2410c; font-size: 0.80rem;">
                            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                            <div>
                                <span class="fw-bold">TEST INSTRUCTIONS:</span> Write your final answer letter before each question number (e.g. <code>A 1.</code>). Answers elsewhere will not be counted by the OCR scanner.
                            </div>
                        </div>

                        <!-- Questions List -->
                        <div class="d-flex flex-column gap-3">
                            @foreach (var q in exam.Questions)
                            {
                                <div class="p-3 bg-white rounded" style="border: 1px solid #e2e8f0;">
                                    <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                                        <p class="fw-bold mb-0" style="font-size: 0.88rem; color: #1e293b;">
                                            <span class="font-monospace text-muted me-1">______ @q.Number.</span> @q.QuestionText
                                        </p>
                                        <span class="badge fw-semibold flex-shrink-0" style="background-color: #f0fdf4; color: #16a34a; border: 1px solid #86efac; font-size: 0.68rem; border-radius: 20px; padding: 2px 8px;">
                                            KEY: @q.CorrectAnswer
                                        </span>
                                    </div>

                                    <div class="row g-2 ps-3 mb-2" style="font-size: 0.82rem; color: #475569;">
                                        <div class="col-sm-6">
                                            <span class="fw-bold" style="color: @(q.CorrectAnswer.Equals("A", StringComparison.OrdinalIgnoreCase) ? "#16a34a" : "#64748b");">A.</span> @q.OptionA
                                        </div>
                                        <div class="col-sm-6">
                                            <span class="fw-bold" style="color: @(q.CorrectAnswer.Equals("B", StringComparison.OrdinalIgnoreCase) ? "#16a34a" : "#64748b");">B.</span> @q.OptionB
                                        </div>
                                        <div class="col-sm-6">
                                            <span class="fw-bold" style="color: @(q.CorrectAnswer.Equals("C", StringComparison.OrdinalIgnoreCase) ? "#16a34a" : "#64748b");">C.</span> @q.OptionC
                                        </div>
                                        <div class="col-sm-6">
                                            <span class="fw-bold" style="color: @(q.CorrectAnswer.Equals("D", StringComparison.OrdinalIgnoreCase) ? "#16a34a" : "#64748b");">D.</span> @q.OptionD
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(q.Explanation))
                                    {
                                        <div class="pt-2 mt-2" style="border-top: 1px solid #f1f5f9; font-size: 0.78rem;">
                                            <span class="fw-semibold" style="color: #2563eb;">Explanation:</span>
                                            <span style="color: #64748b;">@q.Explanation</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div style="height: 3px; background: linear-gradient(90deg, #9333ea, #a78bfa); border-radius: 0 0 0.375rem 0.375rem;"></div>
            </div>
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-5 text-center">
                <div class="rounded p-4 text-center mx-auto" style="max-width: 480px; background-color: #f8fafc; border: 1.5px dashed #cbd5e1; border-radius: 8px;">
                    <i class="bi bi-journal-x" style="font-size: 2.2rem; color: #cbd5e1;"></i>
                    <p class="mt-2 mb-1 fw-semibold" style="color: #64748b; font-size: 0.88rem;">No exam questionnaires generated yet</p>
                    <p class="mb-3" style="color: #94a3b8; font-size: 0.75rem; font-style: italic;">
                        Select a course topic to generate your first multiple-choice exam.
                    </p>
                    <a href="/GenerateQuestionnaire" class="btn fw-semibold d-inline-flex align-items-center gap-2 btn-cc-purple" style="background-color: #fdf4ff; color: #9333ea; border: 1.5px solid #d8b4fe; border-radius: 8px; font-size: 0.78rem;">
                        <i class="bi bi-magic"></i> Generate Exam
                    </a>
                </div>
            </div>
            <div style="height: 3px; background: linear-gradient(90deg, #9333ea, #a78bfa); border-radius: 0 0 0.375rem 0.375rem;"></div>
        </div>
    }

</div>
