@page
@model OCR_Frontend.Pages.QuestionnairesModel
@{
    ViewData["Title"] = "Questionnaires";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-ui-checks" style="color: var(--primary-color);"></i> Exam Questionnaires</h2>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        @if (Model.Exams.Any())
        {
            @foreach (var exam in Model.Exams)
            {
                <div class="col-md-12 mb-4">
                    <div class="card glass-panel shadow-sm">
                        <div class="card-header bg-transparent d-flex justify-content-between align-items-center border-0 pt-4 pb-0">
                            <h5 class="mb-0">
                                <i class="bi bi-file-earmark-text text-primary me-2"></i> Document: @exam.DocumentFileName
                            </h5>
                            <div class="d-flex align-items-center gap-3">
                                <small class="text-muted">Generated: @exam.GeneratedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</small>
                                <form method="post" asp-page-handler="DownloadPdf">
                                    <input type="hidden" name="id" value="@exam.ExamId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-file-earmark-pdf"></i> Download PDF
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted py-5 glass-panel">
                <i class="bi bi-journal-x fs-1"></i>
                <p class="mt-3">No questionnaires found.</p>
                <a asp-page="/Documents" class="btn btn-outline-primary mt-2">View Documents</a>
            </div>
        }
    </div>
</div>
