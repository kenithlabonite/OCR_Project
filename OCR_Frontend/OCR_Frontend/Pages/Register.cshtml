@page
@model OCR_Frontend.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: calc(100vh - 40px);">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body px-4 py-4">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 44px; height: 44px; background-color: #eff6ff; border: 1.5px solid #93c5fd;">
                        <i class="bi bi-person-plus-fill" style="font-size: 1.25rem; color: #2563eb;"></i>
                    </div>
                    <p class="text-uppercase fw-semibold mb-1" style="font-size: 0.70rem; letter-spacing: 0.08em; color: #94a3b8;">
                        REGISTRATION
                    </p>
                    <h1 class="fw-bold mb-1" style="font-size: 1.15rem; color: #1e293b;">Create an Account</h1>
                    <p class="mb-0" style="font-size: 0.82rem; color: #64748b;">Join NexusOCR to generate exams and grade answer sheets</p>
                </div>

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <form method="post">
                    <div class="form-floating mb-3">
                        <input asp-for="Username" type="text" class="form-control" placeholder="johndoe" required />
                        <label asp-for="Username">Username</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" required />
                        <label asp-for="Email">Email Address</label>
                    </div>

                    <div class="form-floating mb-2">
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                        <label asp-for="Password">Password</label>
                    </div>
                    <p class="mb-3" style="font-size: 0.74rem; color: #94a3b8;">
                        Min 8 characters, at least one capital letter.
                    </p>

                    <div class="form-floating mb-3">
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" required />
                        <label asp-for="ConfirmPassword">Confirm Password</label>
                    </div>

                    <div class="form-check mb-4">
                        <input type="checkbox" class="form-check-input" id="terms" required>
                        <label class="form-check-label fw-semibold" for="terms" style="font-size: 0.78rem; color: #475569;">
                            I agree to the <a href="#" class="text-decoration-none" style="color: #2563eb;">Terms of Service</a> and <a href="#" class="text-decoration-none" style="color: #2563eb;">Privacy Policy</a>
                        </label>
                    </div>

                    <button type="submit" class="btn w-100 fw-semibold btn-cc-blue mb-3" style="height: 42px; background-color: #eff6ff; border: 1.5px solid #93c5fd; color: #2563eb; border-radius: 8px; font-size: 0.82rem; letter-spacing: 0.03em;">
                        <i class="bi bi-person-check-fill me-1"></i> Create Account
                    </button>

                    <div class="text-center" style="font-size: 0.80rem; color: #64748b;">
                        Already have an account? <a href="/Login" class="text-decoration-none fw-semibold" style="color: #2563eb;">Sign in</a>
                    </div>
                </form>
            </div>
            <div style="height: 3px; background: linear-gradient(90deg, #2563eb, #60a5fa); border-radius: 0 0 0.375rem 0.375rem;"></div>
        </div>
    </div>
</div>
