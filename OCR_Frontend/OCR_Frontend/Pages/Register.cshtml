@page
@model OCR_Frontend.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-wrapper">
    <div class="auth-container">
        <div class="glass-panel p-5">
            <div class="text-center mb-4">
                <i class="bi bi-person-plus fs-1" style="color: var(--primary-color);"></i>
                <h2 class="mt-3">Create an Account</h2>
                <p>Join NexusOCR today.</p>
            </div>

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label" asp-for="Username">Username</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-person"></i></span>
                        <input asp-for="Username" type="text" class="form-control border-start-0 ps-0" placeholder="johndoe" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="Email">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" placeholder="name@example.com" required />
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label" asp-for="Password">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" required />
                    </div>
                    <small class="text-muted">Min 8 characters, at least one capital letter.</small>
                </div>

                <div class="mb-4">
                    <label class="form-label" asp-for="ConfirmPassword">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" required />
                    </div>
                </div>
                
                <div class="mb-4 form-check">
                    <input type="checkbox" class="form-check-input" id="terms" required>
                    <label class="form-check-label" for="terms">I agree to the <a href="#" style="color: var(--primary-color);">Terms of Service</a> and <a href="#" style="color: var(--primary-color);">Privacy Policy</a></label>
                </div>
                
                <button type="submit" class="btn btn-primary w-100 mb-4">Create Account</button>
                
                <div class="text-center text-muted">
                    Already have an account? <a href="/Login" class="text-decoration-none fw-medium" style="color: var(--primary-color);">Sign in</a>
                </div>
            </form>
        </div>
    </div>
</div>
