@page
@model OCR_Frontend.Pages.DocumentsModel
@{
    ViewData["Title"] = "My Documents";
    var groups = Model.Documents
        .GroupBy(d => !string.IsNullOrWhiteSpace(d.BatchTitle) ? d.BatchTitle : d.FileName)
        .OrderByDescending(g => g.Max(d => d.UploadedAt))
        .ToList();
}

<div class="container-fluid px-3 px-md-4 mt-3">

    <!-- Breadcrumb Card -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2 px-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0" style="font-size: 0.85rem;">
                    <li class="breadcrumb-item">
                        <a href="/Dashboard" class="text-decoration-none" style="color: #2563eb;">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        <span style="font-weight: 600; color: #1e293b;">Documents</span>
                    </li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Page Header Card -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body px-4 py-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px; background-color: #eff6ff;">
                        <i class="bi bi-folder2-open" style="color: #2563eb; font-size: 1rem;"></i>
                    </div>
                    <div>
                        <p class="fw-bold mb-0" style="color: #1e293b; font-size: 1rem;">
                            Document Library
                        </p>
                        <p class="mb-0" style="font-size: 0.75rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.07em;">
                            Uploaded Course Lessons &middot; Ingested Source PDFs
                        </p>
                    </div>
                </div>

                <a href="/UploadPdf" class="btn fw-semibold d-inline-flex align-items-center gap-2 btn-cc-blue" style="background-color: #eff6ff; color: #2563eb; border: 1.5px solid #93c5fd; border-radius: 8px; font-size: 0.78rem; letter-spacing: 0.03em;">
                    <i class="bi bi-cloud-arrow-up-fill" style="font-size: 0.95rem;"></i> Upload New PDF
                </a>
            </div>
        </div>
        <div style="height: 3px; background: linear-gradient(90deg, #2563eb, #60a5fa); border-radius: 0 0 0.375rem 0.375rem;"></div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="d-flex align-items-center gap-2 p-3 rounded mb-3" style="background-color: #fff1f2; border: 1.5px solid #fda4af; color: #e11d48; font-size: 0.82rem;">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <!-- Document Groups -->
    @if (groups.Any())
    {
        @foreach (var group in groups)
        {
            var groupId = "grp-" + Math.Abs(group.Key.GetHashCode());
            <div class="card border-0 shadow-sm mb-3">
                <!-- Group Header -->
                <div class="card-body px-4 py-3" style="border-bottom: 1px solid #f1f5f9;">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#@groupId" aria-expanded="true">
                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 34px; height: 34px; background-color: #eff6ff;">
                                <i class="bi bi-collection-fill" style="color: #2563eb; font-size: 0.85rem;"></i>
                            </div>
                            <div>
                                <p class="fw-bold mb-0" style="color: #1e293b; font-size: 0.92rem;">
                                    @group.Key
                                </p>
                                <p class="mb-0 text-muted" style="font-size: 0.75rem;">
                                    <span class="badge fw-semibold" style="background-color: #f1f5f9; color: #475569; font-size: 0.68rem; border-radius: 20px; padding: 2px 8px;">
                                        @group.Count() @(group.Count() == 1 ? "file" : "files")
                                    </span>
                                    &middot; Latest upload: @group.Max(d => d.UploadedAt).ToLocalTime().ToString("MMM dd, yyyy")
                                </p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <a href="/GenerateQuestionnaire?topic=@Uri.EscapeDataString(group.Key)" class="btn fw-semibold d-inline-flex align-items-center gap-1.5 btn-cc-purple" style="background-color: #fdf4ff; color: #9333ea; border: 1.5px solid #d8b4fe; border-radius: 8px; font-size: 0.72rem; padding: 5px 12px;">
                                <i class="bi bi-magic" style="font-size: 0.80rem;"></i> Generate Exam
                            </a>
                            <button type="button" class="btn btn-sm border-0 p-1 text-muted" data-bs-toggle="collapse" data-bs-target="#@groupId" aria-label="Toggle files">
                                <i class="bi bi-chevron-down" style="font-size: 0.80rem;"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Collapsible Table -->
                <div id="@groupId" class="collapse show">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead>
                                <tr style="border-bottom: 2px solid #e2e8f0; background-color: #f8fafc;">
                                    <th class="ps-4" style="font-size: 0.72rem; color: #64748b; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;">File Name</th>
                                    <th style="font-size: 0.72rem; color: #64748b; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;">Description</th>
                                    <th style="font-size: 0.72rem; color: #64748b; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;">Size</th>
                                    <th style="font-size: 0.72rem; color: #64748b; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;">Date Uploaded</th>
                                    <th class="text-end pe-4" style="font-size: 0.72rem; color: #64748b; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in group)
                                {
                                    <tr style="border-bottom: 1px solid #f1f5f9;">
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-file-earmark-pdf" style="color: #2563eb; font-size: 0.90rem;"></i>
                                                <span class="fw-semibold" style="color: #1e293b; font-size: 0.85rem;">@doc.FileName</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span style="font-size: 0.80rem; color: #64748b;">
                                                @(string.IsNullOrWhiteSpace(doc.Description) ? "—" : doc.Description)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="font-monospace" style="font-size: 0.80rem; color: #475569;">
                                                @((doc.FileSizeBytes / 1024.0 / 1024.0).ToString("0.00")) MB
                                            </span>
                                        </td>
                                        <td>
                                            <span style="font-size: 0.80rem; color: #64748b;">
                                                @doc.UploadedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                            </span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <form method="post" asp-page-handler="Download" class="d-inline">
                                                <input type="hidden" name="id" value="@doc.Id" />
                                                <button type="submit" class="btn btn-sm fw-semibold d-inline-flex align-items-center gap-1 btn-cc-blue" title="Download Original PDF" style="background-color: #eff6ff; color: #2563eb; border: 1.5px solid #93c5fd; border-radius: 6px; font-size: 0.72rem; padding: 2px 8px;">
                                                    <i class="bi bi-download" style="font-size: 0.70rem;"></i> Download
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div style="height: 3px; background: linear-gradient(90deg, #2563eb, #60a5fa); border-radius: 0 0 0.375rem 0.375rem;"></div>
            </div>
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-5 text-center">
                <div class="rounded p-4 text-center mx-auto" style="max-width: 480px; background-color: #f8fafc; border: 1.5px dashed #cbd5e1; border-radius: 8px;">
                    <i class="bi bi-folder-x" style="font-size: 2.2rem; color: #cbd5e1;"></i>
                    <p class="mt-2 mb-1 fw-semibold" style="color: #64748b; font-size: 0.88rem;">No documents found</p>
                    <p class="mb-3" style="color: #94a3b8; font-size: 0.75rem; font-style: italic;">
                        Upload course materials or lecture PDFs to populate your document library.
                    </p>
                    <a href="/UploadPdf" class="btn fw-semibold d-inline-flex align-items-center gap-2 btn-cc-blue" style="background-color: #eff6ff; color: #2563eb; border: 1.5px solid #93c5fd; border-radius: 8px; font-size: 0.78rem;">
                        <i class="bi bi-cloud-arrow-up-fill"></i> Upload PDF
                    </a>
                </div>
            </div>
            <div style="height: 3px; background: linear-gradient(90deg, #2563eb, #60a5fa); border-radius: 0 0 0.375rem 0.375rem;"></div>
        </div>
    }

</div>
