@page
@model OCR_Frontend.Pages.DocumentsModel
@{
    ViewData["Title"] = "My Documents";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-folder2-open" style="color: var(--primary-color);"></i> My Documents</h2>
        <a asp-page="/UploadPdf" class="btn btn-primary"><i class="bi bi-upload me-2"></i>Upload New</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="glass-panel p-4">
        @if (Model.Documents.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>File Name</th>
                            <th>Description</th>
                            <th>Size</th>
                            <th>Date Uploaded</th>
                            <th>AI Summary</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model.Documents)
                        {
                            <tr>
                                <td>
                                    <i class="bi bi-file-earmark-pdf text-danger me-2"></i>
                                    <strong>@doc.FileName</strong>
                                </td>
                                <td><small class="text-muted">@(string.IsNullOrEmpty(doc.Description) ? "-" : doc.Description)</small></td>
                                <td><small>@((doc.FileSizeBytes / 1024.0 / 1024.0).ToString("0.00")) MB</small></td>
                                <td><small>@doc.UploadedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</small></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(doc.AiSummary))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="popover" title="AI Summary" data-bs-content="@doc.AiSummary">
                                            <i class="bi bi-magic"></i> View
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted"><small>No summary</small></span>
                                    }
                                </td>
                                <td class="text-end">
                                     <div class="d-flex justify-content-end gap-2">
                                         <a href="/GenerateQuestionnaire?documentId=@doc.Id" class="btn btn-sm btn-outline-success" title="Generate Exam">
                                             <i class="bi bi-cpu"></i>
                                         </a>
                                         <form method="post" asp-page-handler="Download">
                                             <input type="hidden" name="id" value="@doc.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary" title="Download">
                                                <i class="bi bi-download"></i>
                                            </button>
                                        </form>
                                        <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Are you sure you want to delete this document?');">
                                            <input type="hidden" name="id" value="@doc.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-file-earmark-x fs-1"></i>
                <p class="mt-3">No documents found. Upload your first PDF to get started.</p>
                <a asp-page="/UploadPdf" class="btn btn-outline-primary mt-2">Upload PDF</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Initialize bootstrap popovers for the AI summaries
        document.addEventListener("DOMContentLoaded", function(){
            var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'))
            var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
                return new bootstrap.Popover(popoverTriggerEl)
            })
        });
    </script>
}
