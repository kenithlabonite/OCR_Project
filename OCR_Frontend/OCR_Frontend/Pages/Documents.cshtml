@page
@model OCR_Frontend.Pages.DocumentsModel
@{
    ViewData["Title"] = "My Documents";
    var groups = Model.Documents
        .GroupBy(d => !string.IsNullOrWhiteSpace(d.BatchTitle) ? d.BatchTitle : d.FileName)
        .OrderByDescending(g => g.Max(d => d.UploadedAt))
        .ToList();
}

<div class="container-fluid px-3 px-md-4 mt-3">

    <!-- Breadcrumb Card -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2 px-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0" style="font-size: 0.85rem;">
                    <li class="breadcrumb-item">
                        <a href="/Dashboard" class="text-decoration-none" style="color: #2563eb;">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        <span style="font-weight: 600; color: #1e293b;">Documents</span>
                    </li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Page Header Card -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body px-4 py-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px; background-color: #eff6ff;">
                        <i class="bi bi-folder2-open" style="color: #2563eb; font-size: 1rem;"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <p class="fw-bold mb-0" style="color: #1e293b; font-size: 1rem;">
                                Document Library
                            </p>
                            @if (Model.IsAdmin)
                            {
                                <span class="badge" style="background-color: #fff1f2; color: #e11d48; border: 1px solid #fda4af; font-size: 0.65rem; border-radius: 20px; padding: 2px 7px;">
                                    <i class="bi bi-shield-check me-1"></i>ADMIN MODE
                                </span>
                            }
                        </div>
                        <p class="mb-0" style="font-size: 0.75rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.07em;">
                            Uploaded Course Lessons &middot; Ingested Source PDFs
                        </p>
                    </div>
                </div>

                <a href="/UploadPdf" class="btn fw-semibold d-inline-flex align-items-center gap-2 btn-cc-blue" style="background-color: #eff6ff; color: #2563eb; border: 1.5px solid #93c5fd; border-radius: 8px; font-size: 0.78rem; letter-spacing: 0.03em;">
                    <i class="bi bi-cloud-arrow-up-fill" style="font-size: 0.95rem;"></i> Upload New PDF
                </a>
            </div>
        </div>
        <div style="height: 3px; background: linear-gradient(90deg, #2563eb, #60a5fa); border-radius: 0 0 0.375rem 0.375rem;"></div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="d-flex align-items-center gap-2 p-3 rounded mb-3" style="background-color: #f0fdf4; border: 1.5px solid #86efac; color: #16a34a; font-size: 0.82rem;">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="d-flex align-items-center gap-2 p-3 rounded mb-3" style="background-color: #fff1f2; border: 1.5px solid #fda4af; color: #e11d48; font-size: 0.82rem;">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <!-- Document Groups -->
    @if (groups.Any())
    {
        @foreach (var group in groups)
        {
            var groupId = "grp-" + Math.Abs(group.Key.GetHashCode());
            <div class="card border-0 shadow-sm mb-3">
                <!-- Group Header -->
                <div class="card-body px-4 py-3" style="border-bottom: 1px solid #f1f5f9;">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#@groupId" aria-expanded="true">
                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 34px; height: 34px; background-color: #eff6ff;">
                                <i class="bi bi-collection-fill" style="color: #2563eb; font-size: 0.85rem;"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <p class="fw-bold mb-0" style="color: #1e293b; font-size: 0.92rem;">
                                        @group.Key
                                    </p>
                                    @if (Model.IsAdmin)
                                    {
                                        <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" title="Admin: Edit Batch Title" 
                                                data-batch-title="@group.Key" 
                                                onclick="event.stopPropagation(); openEditBatchModalFromButton(this);" 
                                                style="color: #64748b; font-size: 0.85rem;">
                                            <i class="bi bi-pencil-square text-primary"></i>
                                        </button>
                                    }
                                </div>
                                <p class="mb-0 text-muted" style="font-size: 0.75rem;">
                                    <span class="badge fw-semibold" style="background-color: #f1f5f9; color: #475569; font-size: 0.68rem; border-radius: 20px; padding: 2px 8px;">
                                        @group.Count() @(group.Count() == 1 ? "file" : "files")
                                    </span>
                                    &middot; Latest upload: @group.Max(d => d.UploadedAt).ToLocalTime().ToString("MMM dd, yyyy")
                                </p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            @if (Model.IsAdmin)
                            {
                                <!-- <button type="button" class="btn fw-semibold d-inline-flex align-items-center gap-1.5 btn-sm btn-outline-secondary" 
                                        data-batch-title="@group.Key" 
                                        onclick="openEditBatchModalFromButton(this);" 
                                        title="Admin: Edit Batch Title" 
                                        style="border-radius: 8px; font-size: 0.72rem; padding: 5px 10px; height: 32px;">
                                    <i class="bi bi-pencil-square text-primary"></i> Edit Batch Title
                                </button> -->
                            }
                            <a href="/GenerateQuestionnaire?topic=@Uri.EscapeDataString(group.Key)" class="btn fw-semibold d-inline-flex align-items-center gap-1.5 btn-cc-purple" style="background-color: #fdf4ff; color: #9333ea; border: 1.5px solid #d8b4fe; border-radius: 8px; font-size: 0.72rem; padding: 5px 12px; height: 32px;">
                                <i class="bi bi-magic" style="font-size: 0.80rem;"></i> Generate Exam
                            </a>
                            <button type="button" class="btn btn-sm border-0 p-1 text-muted" data-bs-toggle="collapse" data-bs-target="#@groupId" aria-label="Toggle files">
                                <i class="bi bi-chevron-down" style="font-size: 0.80rem;"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Collapsible Table -->
                <div id="@groupId" class="collapse show">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead>
                                <tr style="border-bottom: 2px solid #e2e8f0; background-color: #f8fafc;">
                                    <th class="ps-4" style="font-size: 0.72rem; color: #64748b; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;">File Name</th>
                                    <th style="font-size: 0.72rem; color: #64748b; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;">Description</th>
                                    <th style="font-size: 0.72rem; color: #64748b; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;">Size</th>
                                    <th style="font-size: 0.72rem; color: #64748b; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;">Date Uploaded</th>
                                    <th class="text-end pe-4" style="font-size: 0.72rem; color: #64748b; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in group)
                                {
                                    <tr style="border-bottom: 1px solid #f1f5f9;">
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-file-earmark-pdf" style="color: #2563eb; font-size: 0.90rem;"></i>
                                                <span class="fw-semibold" style="color: #1e293b; font-size: 0.85rem;">@doc.FileName</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span style="font-size: 0.80rem; color: #64748b;">
                                                @(string.IsNullOrWhiteSpace(doc.Description) ? "—" : doc.Description)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="font-monospace" style="font-size: 0.80rem; color: #475569;">
                                                @((doc.FileSizeBytes / 1024.0 / 1024.0).ToString("0.00")) MB
                                            </span>
                                        </td>
                                        <td>
                                            <span style="font-size: 0.80rem; color: #64748b;">
                                                @doc.UploadedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                            </span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex align-items-center justify-content-end gap-1.5">
                                                @if (Model.IsAdmin)
                                                {
                                                    <button type="button" class="btn btn-sm fw-semibold d-inline-flex align-items-center gap-1 btn-outline-secondary" 
                                                            data-doc-id="@doc.Id" 
                                                            data-doc-filename="@doc.FileName" 
                                                            data-doc-batch="@(doc.BatchTitle ?? "")" 
                                                            onclick="openEditDocModalFromButton(this);" 
                                                            title="Admin: Edit Batch for this document" 
                                                            style="border-radius: 6px; font-size: 0.72rem; padding: 2px 8px;">
                                                        <i class="bi bi-pencil" style="font-size: 0.70rem;"></i> Edit Batch
                                                    </button>
                                                }
                                                <form method="post" asp-page-handler="Download" class="d-inline">
                                                    <input type="hidden" name="id" value="@doc.Id" />
                                                    <button type="submit" class="btn btn-sm fw-semibold d-inline-flex align-items-center gap-1 btn-cc-blue" title="Download Original PDF" style="background-color: #eff6ff; color: #2563eb; border: 1.5px solid #93c5fd; border-radius: 6px; font-size: 0.72rem; padding: 2px 8px;">
                                                        <i class="bi bi-download" style="font-size: 0.70rem;"></i> Download
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div style="height: 3px; background: linear-gradient(90deg, #2563eb, #60a5fa); border-radius: 0 0 0.375rem 0.375rem;"></div>
            </div>
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-5 text-center">
                <div class="rounded p-4 text-center mx-auto" style="max-width: 480px; background-color: #f8fafc; border: 1.5px dashed #cbd5e1; border-radius: 8px;">
                    <i class="bi bi-folder-x" style="font-size: 2.2rem; color: #cbd5e1;"></i>
                    <p class="mt-2 mb-1 fw-semibold" style="color: #64748b; font-size: 0.88rem;">No documents found</p>
                    <p class="mb-3" style="color: #94a3b8; font-size: 0.75rem; font-style: italic;">
                        Upload course materials or lecture PDFs to populate your document library.
                    </p>
                    <a href="/UploadPdf" class="btn fw-semibold d-inline-flex align-items-center gap-2 btn-cc-blue" style="background-color: #eff6ff; color: #2563eb; border: 1.5px solid #93c5fd; border-radius: 8px; font-size: 0.78rem;">
                        <i class="bi bi-cloud-arrow-up-fill"></i> Upload PDF
                    </a>
                </div>
            </div>
            <div style="height: 3px; background: linear-gradient(90deg, #2563eb, #60a5fa); border-radius: 0 0 0.375rem 0.375rem;"></div>
        </div>
    }

    <!-- ── Admin Only Modals ── -->
    @if (Model.IsAdmin)
    {
        <!-- Edit Entire Batch Title Modal -->
        <div class="modal fade" id="editBatchTitleModal" tabindex="-1" aria-labelledby="editBatchTitleModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                    <form method="post" asp-page-handler="UpdateBatchTitle">
                        <div class="modal-header text-white border-0 py-3" style="background: linear-gradient(135deg, #2563eb, #3b82f6);">
                            <h5 class="modal-title fw-bold text-white mb-0" id="editBatchTitleModalLabel">
                                <i class="bi bi-pencil-square me-2"></i>Edit Batch Title
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <input type="hidden" id="modalOldBatchTitle" name="oldTitle" />

                            <div class="mb-3">
                                <label class="form-label text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.70rem;">Current Batch Title</label>
                                <div class="p-2 rounded bg-light border text-dark fw-semibold" id="modalCurrentBatchTitleDisplay" style="font-size: 0.88rem;"></div>
                            </div>

                            <div class="mb-3">
                                <label for="modalNewBatchTitle" class="form-label fw-semibold" style="font-size: 0.85rem; color: #1e293b;">
                                    New Batch Title / Subject <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="modalNewBatchTitle" name="newTitle" class="form-control" placeholder="e.g. Science 10 - Quarter 1" required style="border: 1.5px solid #e2e8f0; border-radius: 8px; font-size: 0.85rem;" />
                                <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">
                                    Updating this will rename the batch title across all documents grouped under this title.
                                </small>
                            </div>
                        </div>
                        <div class="modal-footer border-0 bg-light py-2 px-4">
                            <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary btn-sm px-4 fw-semibold" style="border-radius: 6px;">
                                <i class="bi bi-check2 me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Edit Single Document Batch Title Modal -->
        <div class="modal fade" id="editDocBatchModal" tabindex="-1" aria-labelledby="editDocBatchModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                    <form method="post" asp-page-handler="UpdateDocumentBatchTitle">
                        <div class="modal-header text-white border-0 py-3" style="background: linear-gradient(135deg, #2563eb, #3b82f6);">
                            <h5 class="modal-title fw-bold text-white mb-0" id="editDocBatchModalLabel">
                                <i class="bi bi-file-earmark-text me-2"></i>Edit Document Batch Title
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                            <input type="hidden" id="modalDocId" name="id" />

                            <div class="mb-3">
                                <label class="form-label text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.70rem;">File Name</label>
                                <div class="p-2 rounded bg-light border text-dark fw-semibold" id="modalDocFileNameDisplay" style="font-size: 0.85rem;"></div>
                            </div>

                            <div class="mb-3">
                                <label for="modalDocBatchTitle" class="form-label fw-semibold" style="font-size: 0.85rem; color: #1e293b;">
                                    Batch Title / Subject
                                </label>
                                <input type="text" id="modalDocBatchTitle" name="batchTitle" class="form-control" placeholder="e.g. Science 10 - Quarter 1" style="border: 1.5px solid #e2e8f0; border-radius: 8px; font-size: 0.85rem;" />
                                <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">
                                    Assigns or moves this document to a specific batch title.
                                </small>
                            </div>
                        </div>
                        <div class="modal-footer border-0 bg-light py-2 px-4">
                            <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary btn-sm px-4 fw-semibold" style="border-radius: 6px;">
                                <i class="bi bi-check2 me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

</div>

@section Scripts {
    @if (Model.IsAdmin)
    {
        <script>
            function openEditBatchModalFromButton(btn) {
                var title = btn.getAttribute('data-batch-title') || '';
                document.getElementById('modalOldBatchTitle').value = title;
                document.getElementById('modalCurrentBatchTitleDisplay').textContent = title;
                document.getElementById('modalNewBatchTitle').value = title;
                var modal = new bootstrap.Modal(document.getElementById('editBatchTitleModal'));
                modal.show();
            }

            function openEditDocModalFromButton(btn) {
                var id = btn.getAttribute('data-doc-id');
                var filename = btn.getAttribute('data-doc-filename') || '';
                var batch = btn.getAttribute('data-doc-batch') || '';
                document.getElementById('modalDocId').value = id;
                document.getElementById('modalDocFileNameDisplay').textContent = filename;
                document.getElementById('modalDocBatchTitle').value = batch;
                var modal = new bootstrap.Modal(document.getElementById('editDocBatchModal'));
                modal.show();
            }
        </script>
    }
}
