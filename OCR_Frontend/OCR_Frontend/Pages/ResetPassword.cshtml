@page
@model OCR_Frontend.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-wrapper">
    <div class="auth-container">
        <div class="glass-panel p-5">
            <div class="text-center mb-4">
                <i class="bi bi-key fs-1" style="color: var(--primary-color);"></i>
                <h2 class="mt-3">Reset Your Password</h2>
                <p>Enter the 6-digit code sent to <strong>@Model.Email</strong></p>
            </div>

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <form method="post">
                <input type="hidden" asp-for="Email" />

                <div class="mb-3">
                    <label class="form-label" asp-for="Otp">Reset Code</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-123"></i></span>
                        <input asp-for="Otp" type="text" class="form-control border-start-0 ps-0"
                               placeholder="Enter 6-digit code" maxlength="6" required
                               style="letter-spacing: 4px; font-weight: bold;" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" asp-for="NewPassword">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                        <input asp-for="NewPassword" type="password" class="form-control border-start-0 ps-0"
                               placeholder="••••••••" required />
                    </div>
                    <small class="text-muted">Min 8 characters, at least one capital letter.</small>
                </div>

                <div class="mb-4">
                    <label class="form-label" asp-for="ConfirmPassword">Confirm New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 ps-0"
                               placeholder="••••••••" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-4">Reset Password</button>

                <div class="text-center text-muted">
                    Didn't receive the code? <a href="/ForgotPassword" class="text-decoration-none fw-medium" style="color: var(--primary-color);">Try again</a>
                </div>
            </form>
        </div>
    </div>
</div>
