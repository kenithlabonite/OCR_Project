@page
@model OCR_Frontend.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: calc(100vh - 40px);">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body px-4 py-4">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 44px; height: 44px; background-color: #eff6ff; border: 1.5px solid #93c5fd;">
                        <i class="bi bi-key-fill" style="font-size: 1.25rem; color: #2563eb;"></i>
                    </div>
                    <p class="text-uppercase fw-semibold mb-1" style="font-size: 0.70rem; letter-spacing: 0.08em; color: #94a3b8;">
                        PASSWORD RESET
                    </p>
                    <h1 class="fw-bold mb-1" style="font-size: 1.15rem; color: #1e293b;">Reset Your Password</h1>
                    <p class="mb-0" style="font-size: 0.82rem; color: #64748b;">
                        Enter the 6-digit code sent to <strong class="text-dark">@Model.Email</strong>
                    </p>
                </div>

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <form method="post">
                    <input type="hidden" asp-for="Email" />

                    <div class="form-floating mb-3">
                        <input asp-for="Otp" type="text" class="form-control font-monospace text-center fw-bold"
                               placeholder="123456" maxlength="6" required
                               style="letter-spacing: 6px; font-size: 1.25rem;" />
                        <label asp-for="Otp">6-Digit Reset Code</label>
                    </div>

                    <div class="form-floating mb-2">
                        <input asp-for="NewPassword" type="password" class="form-control"
                               placeholder="••••••••" required />
                        <label asp-for="NewPassword">New Password</label>
                    </div>
                    <p class="mb-3" style="font-size: 0.74rem; color: #94a3b8;">
                        Min 8 characters, at least one capital letter.
                    </p>

                    <div class="form-floating mb-4">
                        <input asp-for="ConfirmPassword" type="password" class="form-control"
                               placeholder="••••••••" required />
                        <label asp-for="ConfirmPassword">Confirm New Password</label>
                    </div>

                    <button type="submit" class="btn w-100 fw-semibold btn-cc-blue mb-3" style="height: 42px; background-color: #eff6ff; border: 1.5px solid #93c5fd; color: #2563eb; border-radius: 8px; font-size: 0.82rem; letter-spacing: 0.03em;">
                        <i class="bi bi-shield-lock-fill me-1"></i> Reset Password
                    </button>

                    <div class="text-center" style="font-size: 0.80rem; color: #64748b;">
                        Didn't receive the code? <a href="/ForgotPassword" class="text-decoration-none fw-semibold" style="color: #2563eb;">Try again</a>
                    </div>
                </form>
            </div>
            <div style="height: 3px; background: linear-gradient(90deg, #2563eb, #60a5fa); border-radius: 0 0 0.375rem 0.375rem;"></div>
        </div>
    </div>
</div>
