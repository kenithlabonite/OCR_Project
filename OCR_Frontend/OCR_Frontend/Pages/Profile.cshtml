@page
@model OCR_Frontend.Pages.ProfileModel
@{
    ViewData["Title"] = "Account Profile";
    var showEditFormInitially = !string.IsNullOrEmpty(Model.SuccessMessage) || !string.IsNullOrEmpty(Model.ErrorMessage);
}

<div class="container-fluid px-3 px-md-4 py-3">

    <!-- Breadcrumb Card -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body px-4 py-2">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0" style="font-size: 0.78rem;">
                    <li class="breadcrumb-item"><a asp-page="/Dashboard" class="text-decoration-none fw-semibold" style="color: #64748b;">Dashboard</a></li>
                    <li class="breadcrumb-item active fw-semibold" aria-current="page" style="color: #2563eb;">Account Profile</li>
                </ol>
            </nav>
        </div>
        <div style="height: 3px; background: linear-gradient(90deg, #2563eb, #60a5fa); border-radius: 0 0 0.375rem 0.375rem;"></div>
    </div>

    <!-- Alerts -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="card border-0 shadow-sm mb-3" style="background-color: #f0fdf4; border: 1.5px solid #86efac !important;">
            <div class="card-body px-4 py-2 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2" style="color: #16a34a; font-size: 0.85rem; font-weight: 500;">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@Model.SuccessMessage</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="font-size: 0.75rem;"></button>
            </div>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="card border-0 shadow-sm mb-3" style="background-color: #fff1f2; border: 1.5px solid #fda4af !important;">
            <div class="card-body px-4 py-2 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2" style="color: #e11d48; font-size: 0.85rem; font-weight: 500;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="font-size: 0.75rem;"></button>
            </div>
        </div>
    }

    <!-- Profile Header Card -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body px-4 py-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 44px; height: 44px; background-color: #eff6ff; border: 1.5px solid #93c5fd;">
                        <i class="bi bi-person-fill" style="color: #2563eb; font-size: 1.35rem;"></i>
                    </div>
                    <div>
                        <p class="text-uppercase fw-semibold mb-0" style="font-size: 0.70rem; letter-spacing: 0.08em; color: #94a3b8;">
                            <i class="bi bi-person-badge me-1"></i> USER PROFILE
                        </p>
                        <h1 class="fw-bold mb-0" style="font-size: 1.05rem; color: #1e293b;">
                            @(string.IsNullOrWhiteSpace(Model.Input.FirstName) && string.IsNullOrWhiteSpace(Model.Input.LastName) 
                                ? Model.Input.Username 
                                : $"{Model.Input.FirstName} {Model.Input.LastName}")
                        </h1>
                        <div class="d-flex align-items-center gap-2 mt-1" style="font-size: 0.78rem; color: #64748b;">
                            <span><i class="bi bi-envelope me-1"></i>@Model.Input.Email</span>
                            <span>•</span>
                            <span>ID: <code class="font-monospace" style="color: #64748b;">@(Model.UserId ?? "N/A")</code></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    @if (Model.UserRole == "Admin")
                    {
                        <span class="badge fw-semibold" style="font-size: 0.68rem; background-color: #fff1f2; border: 1.5px solid #fda4af; color: #e11d48; border-radius: 6px; padding: 0.35rem 0.65rem;">
                            <i class="bi bi-shield-check me-1"></i>ADMINISTRATOR
                        </span>
                    }
                    else
                    {
                        <span class="badge fw-semibold" style="font-size: 0.68rem; background-color: #eff6ff; border: 1.5px solid #93c5fd; color: #2563eb; border-radius: 6px; padding: 0.35rem 0.65rem;">
                            <i class="bi bi-person-badge me-1"></i>TEACHER
                        </span>
                    }

                    @if (Model.Input.Status == "Active")
                    {
                        <span class="badge fw-semibold" style="font-size: 0.68rem; background-color: #f0fdf4; border: 1.5px solid #86efac; color: #16a34a; border-radius: 6px; padding: 0.35rem 0.65rem;">
                            <i class="bi bi-check-lg me-1"></i>ACTIVE
                        </span>
                    }
                    else
                    {
                        <span class="badge fw-semibold" style="font-size: 0.68rem; background-color: #fff7ed; border: 1.5px solid #fed7aa; color: #c2410c; border-radius: 6px; padding: 0.35rem 0.65rem;">
                            <i class="bi bi-clock-history me-1"></i>@(Model.Input.Status ?? "INACTIVE")
                        </span>
                    }
                </div>
            </div>
        </div>
        <div style="height: 3px; background: linear-gradient(90deg, #2563eb, #60a5fa); border-radius: 0 0 0.375rem 0.375rem;"></div>
    </div>

    <!-- Current Credentials Overview Card -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body px-4 py-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                <p class="text-uppercase fw-semibold mb-0" style="font-size: 0.70rem; letter-spacing: 0.08em; color: #94a3b8;">
                    <i class="bi bi-card-checklist me-1"></i> CURRENT CREDENTIALS OVERVIEW
                </p>
                <button type="button" class="btn btn-sm fw-semibold" id="startEditProfileBtn" 
                        style="background-color: @(showEditFormInitially ? "#fff1f2" : "#eff6ff"); border: 1.5px solid @(showEditFormInitially ? "#fda4af" : "#93c5fd"); color: @(showEditFormInitially ? "#e11d48" : "#2563eb"); border-radius: 8px; font-size: 0.78rem; padding: 0.45rem 1rem;">
                    @if (showEditFormInitially)
                    {
                        <span><i class="bi bi-x-circle me-1"></i> Cancel Editing</span>
                    }
                    else
                    {
                        <span><i class="bi bi-pencil-square me-1"></i> Edit Credentials</span>
                    }
                </button>
            </div>

            <div class="row g-3">
                <!-- Full Name -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="p-3 rounded h-100" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <p class="text-uppercase fw-semibold mb-1" style="font-size: 0.70rem; letter-spacing: 0.08em; color: #94a3b8;">
                            FIRST & LAST NAME
                        </p>
                        <div class="fw-semibold text-truncate" style="font-size: 0.88rem; color: #1e293b;">
                            @(string.IsNullOrWhiteSpace(Model.CurrentProfile?.FirstName) && string.IsNullOrWhiteSpace(Model.CurrentProfile?.LastName) 
                                ? "Not Set" 
                                : $"{Model.CurrentProfile?.FirstName} {Model.CurrentProfile?.LastName}")
                        </div>
                    </div>
                </div>

                <!-- Username -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="p-3 rounded h-100" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <p class="text-uppercase fw-semibold mb-1" style="font-size: 0.70rem; letter-spacing: 0.08em; color: #94a3b8;">
                            USERNAME
                        </p>
                        <div class="fw-semibold text-truncate" style="font-size: 0.88rem; color: #1e293b;">
                            @@@(Model.CurrentProfile?.Username ?? Model.Input.Username)
                        </div>
                    </div>
                </div>

                <!-- Gmail / Email -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="p-3 rounded h-100" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <p class="text-uppercase fw-semibold mb-1" style="font-size: 0.70rem; letter-spacing: 0.08em; color: #94a3b8;">
                            EMAIL ADDRESS
                        </p>
                        <div class="fw-semibold text-truncate" style="font-size: 0.88rem; color: #1e293b;" title="@(Model.CurrentProfile?.Email ?? Model.Input.Email)">
                            @(Model.CurrentProfile?.Email ?? Model.Input.Email)
                        </div>
                    </div>
                </div>

                <!-- Contact Number -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="p-3 rounded h-100" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <p class="text-uppercase fw-semibold mb-1" style="font-size: 0.70rem; letter-spacing: 0.08em; color: #94a3b8;">
                            CONTACT NUMBER
                        </p>
                        <div class="fw-semibold text-truncate" style="font-size: 0.88rem; color: #1e293b;">
                            @(string.IsNullOrWhiteSpace(Model.CurrentProfile?.ContactNumber) ? "Not Provided" : Model.CurrentProfile?.ContactNumber)
                        </div>
                    </div>
                </div>

                <!-- Account Status -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="p-3 rounded h-100" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <p class="text-uppercase fw-semibold mb-1" style="font-size: 0.70rem; letter-spacing: 0.08em; color: #94a3b8;">
                            STATUS
                        </p>
                        <div>
                            @if (Model.CurrentProfile?.Status == "Active")
                            {
                                <span class="badge fw-semibold" style="font-size: 0.68rem; background-color: #f0fdf4; border: 1.5px solid #86efac; color: #16a34a; border-radius: 6px; padding: 0.3rem 0.6rem;">
                                    <i class="bi bi-check-lg me-1"></i>Active
                                </span>
                            }
                            else
                            {
                                <span class="badge fw-semibold" style="font-size: 0.68rem; background-color: #fff7ed; border: 1.5px solid #fed7aa; color: #c2410c; border-radius: 6px; padding: 0.3rem 0.6rem;">
                                    <i class="bi bi-clock-history me-1"></i>@(Model.CurrentProfile?.Status ?? "Active")
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Account Role -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="p-3 rounded h-100" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <p class="text-uppercase fw-semibold mb-1" style="font-size: 0.70rem; letter-spacing: 0.08em; color: #94a3b8;">
                            ASSIGNED ROLE
                        </p>
                        <div>
                            @if (Model.UserRole == "Admin")
                            {
                                <span class="badge fw-semibold" style="font-size: 0.68rem; background-color: #fff1f2; border: 1.5px solid #fda4af; color: #e11d48; border-radius: 6px; padding: 0.3rem 0.6rem;">
                                    <i class="bi bi-shield-check me-1"></i>Admin
                                </span>
                            }
                            else
                            {
                                <span class="badge fw-semibold" style="font-size: 0.68rem; background-color: #eff6ff; border: 1.5px solid #93c5fd; color: #2563eb; border-radius: 6px; padding: 0.3rem 0.6rem;">
                                    <i class="bi bi-person me-1"></i>Teacher
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Account ID -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="p-3 rounded h-100" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <p class="text-uppercase fw-semibold mb-1" style="font-size: 0.70rem; letter-spacing: 0.08em; color: #94a3b8;">
                            ACCOUNT ID
                        </p>
                        <div class="font-monospace text-truncate" style="font-size: 0.85rem; color: #64748b;">
                            @(Model.UserId ?? "N/A")
                        </div>
                    </div>
                </div>

                <!-- Physical Address -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="p-3 rounded h-100" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <p class="text-uppercase fw-semibold mb-1" style="font-size: 0.70rem; letter-spacing: 0.08em; color: #94a3b8;">
                            PHYSICAL ADDRESS
                        </p>
                        <div class="fw-semibold text-truncate" style="font-size: 0.88rem; color: #1e293b;" title="@(Model.CurrentProfile?.Address)">
                            @(string.IsNullOrWhiteSpace(Model.CurrentProfile?.Address) ? "Not Provided" : Model.CurrentProfile?.Address)
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div style="height: 3px; background: linear-gradient(90deg, #2563eb, #60a5fa); border-radius: 0 0 0.375rem 0.375rem;"></div>
    </div>

    <!-- Credentials Edit Form Card -->
    <div class="card border-0 shadow-sm mb-4" id="editProfileFormContainer" style="display: @(showEditFormInitially ? "block" : "none");">
        <div class="card-body px-4 py-3">
            <p class="text-uppercase fw-semibold mb-3" style="font-size: 0.70rem; letter-spacing: 0.08em; color: #94a3b8;">
                <i class="bi bi-person-gear me-1"></i> EDIT PERSONAL INFORMATION & CREDENTIALS
            </p>

            <form method="post">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Input.FirstName" type="text" class="form-control" placeholder="John" />
                            <label asp-for="Input.FirstName">First Name</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Input.LastName" type="text" class="form-control" placeholder="Doe" />
                            <label asp-for="Input.LastName">Last Name</label>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Input.Username" type="text" class="form-control" required placeholder="johndoe" />
                            <label asp-for="Input.Username">Username</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Input.Email" type="email" class="form-control" required placeholder="name@example.com" />
                            <label asp-for="Input.Email">Email Address</label>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Input.ContactNumber" type="tel" class="form-control" placeholder="+1 (555) 000-0000" />
                            <label asp-for="Input.ContactNumber">Contact Number</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="Input.Status" class="form-select">
                                <option value="Active">Active</option>
                                <option value="Busy">Busy</option>
                                <option value="Away">Away</option>
                                <option value="On Leave">On Leave</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                            <label asp-for="Input.Status">Account Status</label>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="text-uppercase fw-semibold mb-2 d-block" style="font-size: 0.70rem; letter-spacing: 0.08em; color: #94a3b8;">
                        <i class="bi bi-geo-alt me-1"></i> Physical Address
                    </label>
                    <textarea asp-for="Input.Address" class="form-control" rows="2" placeholder="123 Main Street, City, Country" style="border: 1.5px solid #e2e8f0; border-radius: 8px; font-size: 0.85rem; color: #1e293b;"></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="/Dashboard" class="btn btn-sm fw-semibold btn-cc-neutral" style="background-color: #f1f5f9; border: 1.5px solid #e2e8f0; color: #475569; border-radius: 8px; font-size: 0.78rem; padding: 0.45rem 1.25rem;">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-sm fw-semibold btn-cc-blue" style="background-color: #eff6ff; border: 1.5px solid #93c5fd; color: #2563eb; border-radius: 8px; font-size: 0.78rem; padding: 0.45rem 1.5rem;">
                        <i class="bi bi-check2-circle me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
        <div style="height: 3px; background: linear-gradient(90deg, #2563eb, #60a5fa); border-radius: 0 0 0.375rem 0.375rem;"></div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Edit Credentials form toggle logic
            const editBtn = document.getElementById('startEditProfileBtn');
            const formContainer = document.getElementById('editProfileFormContainer');

            if (editBtn && formContainer) {
                editBtn.addEventListener('click', function () {
                    const isHidden = formContainer.style.display === 'none' || formContainer.style.display === '';
                    if (isHidden) {
                        formContainer.style.display = 'block';
                        editBtn.innerHTML = '<i class="bi bi-x-circle me-1"></i> Cancel Editing';
                        editBtn.style.backgroundColor = '#fff1f2';
                        editBtn.style.borderColor = '#fda4af';
                        editBtn.style.color = '#e11d48';
                        formContainer.scrollIntoView({ behavior: 'smooth' });
                    } else {
                        formContainer.style.display = 'none';
                        editBtn.innerHTML = '<i class="bi bi-pencil-square me-1"></i> Edit Credentials';
                        editBtn.style.backgroundColor = '#eff6ff';
                        editBtn.style.borderColor = '#93c5fd';
                        editBtn.style.color = '#2563eb';
                    }
                });
            }
        });
    </script>
}
