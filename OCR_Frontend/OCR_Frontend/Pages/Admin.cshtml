@page
@model OCR_Frontend.Pages.AdminModel
@{
    ViewData["Title"] = "Admin & System Logs";
}

<div class="container mt-4">
    <!-- Header Banner -->
    <div class="glass-panel p-4 mb-4 border-0 shadow-sm rounded-4 position-relative overflow-hidden" style="background: linear-gradient(135deg, rgba(220, 38, 38, 0.08) 0%, rgba(239, 68, 68, 0.12) 100%);">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-6 fw-bold mb-2" style="background: linear-gradient(to right, #dc2626, #ef4444); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    <i class="bi bi-shield-lock-fill me-2" style="-webkit-text-fill-color: #dc2626;"></i>Admin Panel & System Logs
                </h1>
                <p class="text-muted fs-5 mb-0">Manage user accounts, view security logs, and monitor PDF/exam operations.</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle p-2 px-3 rounded-pill me-2">
                    <i class="bi bi-people-fill me-1"></i> @Model.Users.Count Users
                </span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle p-2 px-3 rounded-pill">
                    <i class="bi bi-journal-text me-1"></i> @(Model.UserActivityLogs.Count + Model.DocumentExamLogs.Count) Total Logs
                </span>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills mb-4 gap-2" id="adminTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4" id="users-tab" data-bs-toggle="tab" data-bs-target="#users-panel" type="button" role="tab">
                <i class="bi bi-person-gear me-2"></i>User Accounts (@Model.Users.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="user-logs-tab" data-bs-toggle="tab" data-bs-target="#user-logs-panel" type="button" role="tab">
                <i class="bi bi-person-lines-fill me-2"></i>User Activity Logs (@Model.UserActivityLogs.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="doc-logs-tab" data-bs-toggle="tab" data-bs-target="#doc-logs-panel" type="button" role="tab">
                <i class="bi bi-file-earmark-code-fill me-2"></i>Document & Exam Logs (@Model.DocumentExamLogs.Count)
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="adminTabContent">

        <!-- ==================== TAB 1: USER ACCOUNTS ==================== -->
        <div class="tab-pane fade show active" id="users-panel" role="tabpanel">
            <!-- Stats Row -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card glass-panel border-0 shadow-sm">
                        <div class="card-body p-3 text-center">
                            <div class="text-success fs-2 fw-bold">@Model.Users.Count(u => u.IsActive)</div>
                            <small class="text-muted">Active Accounts</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card glass-panel border-0 shadow-sm">
                        <div class="card-body p-3 text-center">
                            <div class="text-danger fs-2 fw-bold">@Model.Users.Count(u => !u.IsActive)</div>
                            <small class="text-muted">Deactivated</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card glass-panel border-0 shadow-sm">
                        <div class="card-body p-3 text-center">
                            <div class="text-primary fs-2 fw-bold">@Model.Users.Count(u => u.Role == "Admin")</div>
                            <small class="text-muted">Administrators</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card glass-panel border-0 shadow-sm">
                        <div class="card-body p-3 text-center">
                            <div class="text-warning fs-2 fw-bold">@Model.Users.Count(u => !u.IsEmailVerified)</div>
                            <small class="text-muted">Unverified</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Users Table -->
            <div class="card glass-panel border-0 shadow-sm mb-5">
                <div class="card-body p-4">
                    <h5 class="card-title mb-3"><i class="bi bi-people-fill text-primary me-2"></i>User Accounts Directory</h5>
                    @if (Model.Users.Count == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-person-x fs-1"></i>
                            <p class="mt-2">No users found.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Username</th>
                                        <th>Email</th>
                                        <th class="text-center">Role</th>
                                        <th class="text-center">Verified</th>
                                        <th class="text-center">Status</th>
                                        <th class="text-center" style="min-width: 260px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model.Users)
                                    {
                                        <tr>
                                            <td><code class="text-dark fw-semibold">@user.Id</code></td>
                                            <td>
                                                <i class="bi bi-person-circle text-primary me-1"></i>
                                                @user.Username
                                            </td>
                                            <td class="text-muted">@user.Email</td>
                                            <td class="text-center">
                                                @if (user.Role == "Admin")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger px-3 py-1">
                                                        <i class="bi bi-shield-fill-check me-1"></i>Admin
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary-subtle text-primary px-3 py-1">
                                                        <i class="bi bi-person me-1"></i>User
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (user.IsEmailVerified)
                                                {
                                                    <span class="text-success"><i class="bi bi-check-circle-fill fs-5"></i></span>
                                                }
                                                else
                                                {
                                                    <span class="text-warning"><i class="bi bi-exclamation-circle-fill fs-5"></i></span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (user.IsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success px-3 py-1">
                                                        <i class="bi bi-check-lg me-1"></i>Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary px-3 py-1">
                                                        <i class="bi bi-x-lg me-1"></i>Inactive
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="d-flex justify-content-center gap-1 flex-wrap">
                                                    <!-- Toggle Active/Deactivate -->
                                                    <form method="post" asp-page-handler="ToggleActive" class="d-inline">
                                                        <input type="hidden" name="userId" value="@user.Id" />
                                                        @if (user.IsActive)
                                                        {
                                                            <button type="submit" class="btn btn-outline-warning btn-sm" title="Deactivate account">
                                                                <i class="bi bi-pause-circle"></i> Deactivate
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="submit" class="btn btn-outline-success btn-sm" title="Activate account">
                                                                <i class="bi bi-play-circle"></i> Activate
                                                            </button>
                                                        }
                                                    </form>

                                                    <!-- Change Role -->
                                                    <form method="post" asp-page-handler="ChangeRole" class="d-inline">
                                                        <input type="hidden" name="userId" value="@user.Id" />
                                                        @if (user.Role == "Admin")
                                                        {
                                                            <input type="hidden" name="newRole" value="User" />
                                                            <button type="submit" class="btn btn-outline-primary btn-sm" title="Demote to User">
                                                                <i class="bi bi-arrow-down-circle"></i> Demote
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <input type="hidden" name="newRole" value="Admin" />
                                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Promote to Admin">
                                                                <i class="bi bi-arrow-up-circle"></i> Promote
                                                            </button>
                                                        }
                                                    </form>

                                                    <!-- Delete User -->
                                                    <form method="post" asp-page-handler="DeleteUser" class="d-inline"
                                                          onsubmit="return confirm('Are you sure you want to permanently delete user @user.Username? This cannot be undone.');">
                                                        <input type="hidden" name="userId" value="@user.Id" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete account permanently">
                                                            <i class="bi bi-trash3"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ==================== TAB 2: USER ACTIVITY LOGS ==================== -->
        <div class="tab-pane fade" id="user-logs-panel" role="tabpanel">
            <div class="card glass-panel border-0 shadow-sm mb-5">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0"><i class="bi bi-person-lines-fill text-primary me-2"></i>User Activity & Security Logs</h5>
                        <span class="text-muted small">Registrations, logins, email verifications & admin status updates</span>
                    </div>

                    @if (Model.UserActivityLogs.Count == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-journal-x fs-1"></i>
                            <p class="mt-2">No user activity logs recorded yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Timestamp</th>
                                        <th>Action</th>
                                        <th>User / Account</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.UserActivityLogs)
                                    {
                                        <tr>
                                            <td class="text-nowrap text-muted small">
                                                <i class="bi bi-clock me-1"></i>@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                            </td>
                                            <td>
                                                @if (log.Action.Contains("Login"))
                                                {
                                                    <span class="badge bg-success-subtle text-success"><i class="bi bi-box-arrow-in-right me-1"></i>@log.Action</span>
                                                }
                                                else if (log.Action.Contains("Registered"))
                                                {
                                                    <span class="badge bg-primary-subtle text-primary"><i class="bi bi-person-plus me-1"></i>@log.Action</span>
                                                }
                                                else if (log.Action.Contains("Deactivated") || log.Action.Contains("Deleted") || log.Action.Contains("Failed"))
                                                {
                                                    <span class="badge bg-danger-subtle text-danger"><i class="bi bi-exclamation-octagon me-1"></i>@log.Action</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info-subtle text-info"><i class="bi bi-info-circle me-1"></i>@log.Action</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(log.Username))
                                                {
                                                    <span class="fw-semibold"><i class="bi bi-person me-1"></i>@log.Username</span>
                                                    @if (!string.IsNullOrEmpty(log.UserId))
                                                    {
                                                        <small class="text-muted ms-1">(@log.UserId)</small>
                                                    }
                                                }
                                                else if (!string.IsNullOrEmpty(log.UserId))
                                                {
                                                    <code>@log.UserId</code>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">System / Anonymous</span>
                                                }
                                            </td>
                                            <td class="text-wrap" style="max-width: 350px;">@log.Details</td>
                                            
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ==================== TAB 3: DOCUMENT & EXAM LOGS ==================== -->
        <div class="tab-pane fade" id="doc-logs-panel" role="tabpanel">
            <div class="card glass-panel border-0 shadow-sm mb-5">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0"><i class="bi bi-file-earmark-code-fill text-purple me-2" style="color: #8b5cf6;"></i>Document Upload, Exam & PDF Download Logs</h5>
                        <span class="text-muted small">Uploads, AI generation, PDF downloads & student OCR answer sheet checking</span>
                    </div>

                    @if (Model.DocumentExamLogs.Count == 0)
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-file-earmark-x fs-1"></i>
                            <p class="mt-2">No document or exam operation logs recorded yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Timestamp</th>
                                        <th>Operation</th>
                                        <th>Details</th>
                                        <th>User</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.DocumentExamLogs)
                                    {
                                        <tr>
                                            <td class="text-nowrap text-muted small">
                                                <i class="bi bi-clock me-1"></i>@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                            </td>
                                            <td>
                                                @if (log.Action.Contains("Upload"))
                                                {
                                                    <span class="badge bg-primary-subtle text-primary"><i class="bi bi-cloud-upload me-1"></i>@log.Action</span>
                                                }
                                                else if (log.Action.Contains("Generated"))
                                                {
                                                    <span class="badge bg-purple-subtle text-purple px-3" style="background-color: #f3e8ff; color: #7e22ce;"><i class="bi bi-robot me-1"></i>@log.Action</span>
                                                }
                                                else if (log.Action.Contains("Downloaded"))
                                                {
                                                    <span class="badge bg-success-subtle text-success"><i class="bi bi-download me-1"></i>@log.Action</span>
                                                }
                                                else if (log.Action.Contains("Graded"))
                                                {
                                                    <span class="badge bg-info-subtle text-info"><i class="bi bi-check-all me-1"></i>@log.Action</span>
                                                }
                                                else if (log.Action.Contains("Deleted"))
                                                {
                                                    <span class="badge bg-danger-subtle text-danger"><i class="bi bi-trash me-1"></i>@log.Action</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary"><i class="bi bi-app-indicator me-1"></i>@log.Action</span>
                                                }
                                            </td>
                                            <td class="text-wrap" style="max-width: 400px;">@log.Details</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(log.Username))
                                                {
                                                    <span class="fw-semibold"><i class="bi bi-person me-1"></i>@log.Username</span>
                                                }
                                                else if (!string.IsNullOrEmpty(log.UserId))
                                                {
                                                    <code>@log.UserId</code>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">System / Web User</span>
                                                }
                                            </td>
                                            
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>
