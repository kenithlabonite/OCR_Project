@page
@model OCR_Frontend.Pages.GenerateQuestionnaireModel
@{
    ViewData["Title"] = "Generate Questionnaire";
}

<div class="container-fluid px-3 px-md-4 mt-3">

    <!-- Breadcrumb Card -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2 px-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0" style="font-size: 0.85rem;">
                    <li class="breadcrumb-item">
                        <a href="/Dashboard" class="text-decoration-none" style="color: #2563eb;">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="/Questionnaires" class="text-decoration-none" style="color: #2563eb;">Questionnaires</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        <span style="font-weight: 600; color: #1e293b;">Generate Exam</span>
                    </li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Page Header Card -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body px-4 py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px; background-color: #fdf4ff;">
                    <i class="bi bi-magic" style="color: #9333ea; font-size: 1rem;"></i>
                </div>
                <div>
                    <p class="fw-bold mb-0" style="color: #1e293b; font-size: 1rem;">
                        Generate AI Questionnaire
                    </p>
                    <p class="mb-0" style="font-size: 0.75rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.07em;">
                        Automated 10-Item Multiple Choice Exam &middot; Multi-Lesson Ingestion
                    </p>
                </div>
            </div>
        </div>
        <div style="height: 3px; background: linear-gradient(90deg, #9333ea, #a78bfa); border-radius: 0 0 0.375rem 0.375rem;"></div>
    </div>

    <!-- Main Generation Card -->
    <div class="row g-3 justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body px-4 py-3">
                    <p class="text-uppercase fw-semibold mb-3" style="font-size: 0.70rem; letter-spacing: 0.08em; color: #94a3b8;">
                        <i class="bi bi-collection-fill me-1"></i> Topic &amp; Lesson Selection
                    </p>

                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div class="d-flex align-items-center justify-content-between p-3 rounded mb-3" style="background-color: #f0fdf4; border: 1.5px solid #86efac; color: #16a34a; font-size: 0.82rem;">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>@Model.SuccessMessage</span>
                            </div>
                            <a href="/Questionnaires" class="fw-semibold text-decoration-none ms-2" style="color: #16a34a;">View Questionnaires &rarr;</a>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="d-flex align-items-center gap-2 p-3 rounded mb-3" style="background-color: #fff1f2; border: 1.5px solid #fda4af; color: #e11d48; font-size: 0.82rem;">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>@Model.ErrorMessage</span>
                        </div>
                    }

                    @if (Model.BatchTitles.Any())
                    {
                        <form method="post" id="generateForm">
                            <div class="form-floating mb-3">
                                <select asp-for="SelectedBatchTitle" id="SelectedBatchTitle" class="form-select" style="border: 1.5px solid #e2e8f0; border-radius: 8px; font-size: 0.85rem;" required>
                                    <option value="">-- SELECT TOPIC / QUARTER TITLE --</option>
                                    @foreach (var batch in Model.BatchTitles)
                                    {
                                        var isSelected = string.Equals(Model.SelectedBatchTitle, batch.Title, StringComparison.OrdinalIgnoreCase);
                                        <option value="@batch.Title" selected="@(isSelected ? "selected" : null)">
                                            @batch.Title @(batch.FileCount > 1 ? $"({batch.FileCount} lessons)" : "")
                                        </option>
                                    }
                                </select>
                                <label for="SelectedBatchTitle" style="font-size: 0.82rem; color: #64748b;">
                                    <i class="bi bi-journal-bookmark-fill me-1"></i> Target Course Topic
                                </label>
                            </div>

                            <!-- Preview of files in selected batch -->
                            <div id="batchPreview" class="mb-4 d-none">
                                <div class="rounded p-3" style="background-color: #f8fafc; border: 1px dashed #cbd5e1;">
                                    <p class="text-uppercase fw-semibold mb-2" style="font-size: 0.68rem; letter-spacing: 0.08em; color: #94a3b8;">
                                        <i class="bi bi-files me-1"></i> Lessons Included in this Exam:
                                    </p>
                                    @foreach (var batch in Model.BatchTitles)
                                    {
                                        <ul class="batch-file-list list-unstyled mb-0 d-none" data-topic="@batch.Title">
                                            @foreach (var fn in batch.FileNames)
                                            {
                                                <li class="d-flex align-items-center gap-2 py-1" style="font-size: 0.80rem; color: #475569;">
                                                    <i class="bi bi-file-earmark-pdf" style="color: #2563eb;"></i>
                                                    <span class="fw-semibold">@fn</span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" id="btnSubmit" class="btn fw-semibold d-inline-flex align-items-center justify-content-center gap-2 w-100 btn-cc-purple" style="background-color: #fdf4ff; color: #9333ea; border: 1.5px solid #d8b4fe; border-radius: 8px; font-size: 0.82rem; letter-spacing: 0.03em; transition: all 0.2s ease; height: 44px;">
                                <i class="bi bi-magic" style="font-size: 0.95rem;"></i>
                                <span id="btnText">Generate 10-Item Questionnaire</span>
                            </button>
                        </form>

                        <div id="loadingIndicator" class="text-center mt-3 p-3 rounded d-none" style="background-color: #f8fafc; border: 1px dashed #cbd5e1;">
                            <div class="spinner-border spinner-border-sm" role="status" style="color: #9333ea;">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2 mb-0" style="font-size: 0.80rem; color: #64748b;">
                                Analyzing lesson content and structuring questions via Gemini AI... This usually takes 15–30 seconds.
                            </p>
                        </div>
                    }
                    else
                    {
                        <!-- Empty State: Designed per Design System -->
                        <div class="rounded p-4 text-center my-3" style="background-color: #f8fafc; border: 1.5px dashed #cbd5e1;">
                            <i class="bi bi-folder-x" style="font-size: 2rem; color: #cbd5e1;"></i>
                            <p class="mt-2 mb-1 fw-semibold" style="color: #64748b; font-size: 0.85rem;">No course PDF documents found.</p>
                            <p class="mb-3" style="color: #94a3b8; font-size: 0.75rem; font-style: italic;">
                                Upload course lessons or syllabus handouts first before generating an AI questionnaire.
                            </p>
                            <a href="/UploadPdf" class="btn fw-semibold d-inline-flex align-items-center gap-2 btn-cc-blue" style="background-color: #eff6ff; color: #2563eb; border: 1.5px solid #93c5fd; border-radius: 8px; font-size: 0.78rem;">
                                <i class="bi bi-cloud-arrow-up-fill"></i> Upload Course PDFs
                            </a>
                        </div>
                    }
                </div>
                <div style="height: 3px; background: linear-gradient(90deg, #9333ea, #a78bfa); border-radius: 0 0 0.375rem 0.375rem;"></div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        const selectEl   = document.getElementById('SelectedBatchTitle');
        const previewDiv = document.getElementById('batchPreview');
        const formEl     = document.getElementById('generateForm');
        const btnSubmit  = document.getElementById('btnSubmit');
        const btnText    = document.getElementById('btnText');
        const loader     = document.getElementById('loadingIndicator');

        function updatePreview() {
            const val = selectEl ? selectEl.value.trim().toLowerCase() : '';
            let matched = false;

            document.querySelectorAll('.batch-file-list').forEach(el => {
                const topic = (el.getAttribute('data-topic') || '').trim().toLowerCase();
                if (val && topic === val) {
                    el.classList.remove('d-none');
                    matched = true;
                } else {
                    el.classList.add('d-none');
                }
            });

            if (matched && previewDiv) {
                previewDiv.classList.remove('d-none');
            } else if (previewDiv) {
                previewDiv.classList.add('d-none');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (selectEl) {
                const urlParams = new URLSearchParams(window.location.search);
                const topicParam = urlParams.get('topic');
                if (topicParam && !selectEl.value) {
                    for (let i = 0; i < selectEl.options.length; i++) {
                        if (selectEl.options[i].value.toLowerCase() === topicParam.toLowerCase()) {
                            selectEl.selectedIndex = i;
                            break;
                        }
                    }
                }
                updatePreview();
                selectEl.addEventListener('change', updatePreview);
            }

            if (formEl) {
                formEl.addEventListener('submit', function () {
                    if (btnSubmit) {
                        btnSubmit.disabled = true;
                        btnSubmit.style.opacity = '0.7';
                        if (btnText) btnText.textContent = 'Generating Questions...';
                    }
                    if (loader) loader.classList.remove('d-none');
                });
            }
        });
    </script>
}
