@{
    var isLoggedIn = Context.Request.Cookies.ContainsKey("AuthToken");
    var userRole = Context.Request.Cookies["UserRole"] ?? "User";
    var displayName = Context.Request.Cookies["DisplayName"] ?? "User";
    var displayEmail = Context.Request.Cookies["DisplayEmail"] ?? "";
    var currentPath = Context.Request.Path.Value ?? "";
    var isAuthPage = currentPath.Equals("/Login", StringComparison.OrdinalIgnoreCase)
                  || currentPath.Equals("/Register", StringComparison.OrdinalIgnoreCase)
                  || currentPath.Equals("/ForgotPassword", StringComparison.OrdinalIgnoreCase)
                  || currentPath.Equals("/ResetPassword", StringComparison.OrdinalIgnoreCase)
                  || currentPath.Equals("/VerifyEmail", StringComparison.OrdinalIgnoreCase)
                  || currentPath.Equals("/", StringComparison.OrdinalIgnoreCase)
                  || (ViewData["HideNavbar"] as bool? == true)
                  || string.Equals(ViewData["Title"]?.ToString(), "Login", StringComparison.OrdinalIgnoreCase);
    var hideNavbar = !isLoggedIn || isAuthPage;

    string IsActive(string path)
    {
        return currentPath.Equals(path, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NexusOCR</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: #f8fafc; color: #1e293b; min-height: 100vh; display: flex; flex-direction: column;">

    @if (!hideNavbar)
    {
        <script>
            // BFCache / History Navigation Guard: Prevents showing cached protected views after logout
            (function () {
                function hasAuthSession() {
                    var cookies = document.cookie.split(';');
                    for (var i = 0; i < cookies.length; i++) {
                        var k = cookies[i].trim();
                        if (k.indexOf('DisplayName=') === 0 || k.indexOf('UserRole=') === 0 || k.indexOf('UserId=') === 0) {
                            return true;
                        }
                    }
                    return false;
                }

                // If restored without active session, redirect immediately
                if (!hasAuthSession()) {
                    window.location.replace('/Login');
                }

                window.addEventListener('pageshow', function (e) {
                    if (e.persisted || !hasAuthSession()) {
                        if (!hasAuthSession()) {
                            window.location.replace('/Login');
                        } else {
                            window.location.reload();
                        }
                    }
                });
            })();
        </script>

        <!-- ================= TOP NAVBAR ================= -->
        <header style="background-color: #ffffff; border-bottom: 1px solid #eef2f6; position: sticky; top: 0; z-index: 1030; height: 54px;">
            <div class="container-fluid px-3 px-md-4 h-100">
                <div class="d-flex align-items-center justify-content-between h-100">
                    
                    <!-- Left: Brand Identity -->
                    <div class="d-flex align-items-center gap-2">
                        <!-- Mobile Sidebar Drawer Toggle -->
                        <button class="btn btn-sm d-lg-none border-0 p-1 me-1 text-slate-600" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebarDrawer" aria-controls="appSidebarDrawer">
                            <i class="bi bi-list fs-5"></i>
                        </button>

                        <a href="/Dashboard" class="text-decoration-none d-inline-flex align-items-center gap-2">
                            <!-- Blue outlined icon badge matching the screenshot layout -->
                            <div class="d-flex align-items-center justify-content-center rounded" style="width: 28px; height: 28px; border: 1.5px solid #60a5fa; background-color: #eff6ff; color: #2563eb;">
                                <i class="bi bi-bezier2" style="font-size: 0.90rem;"></i>
                            </div>
                            <span style="font-size: 0.98rem; font-weight: 700; color: #0f172a; letter-spacing: -0.01em;">NexusOCR</span>
                        </a>
                    </div>

                    <!-- Right: User Menu (Dark slate circular avatar, Name, Dropdown chevron) -->
                    <div class="dropdown">
                        <a class="text-decoration-none d-inline-flex align-items-center gap-2 px-1 py-1" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="@displayName">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 28px; height: 28px; background-color: #334155; color: #ffffff;">
                                <i class="bi bi-person-fill" style="font-size: 0.85rem;"></i>
                            </span>
                            <span class="d-none d-sm-inline" style="font-size: 0.86rem; font-weight: 500; color: #334155;">@displayName</span>
                            <i class="bi bi-chevron-down" style="font-size: 0.65rem; color: #94a3b8;"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-2 mt-2" aria-labelledby="userMenu" style="min-width: 220px; border-radius: 10px; border: 1px solid #eef2f6 !important;">
                            <li>
                                <div class="px-3 py-2">
                                    <div style="font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #94a3b8;">Signed in as</div>
                                    <div class="text-truncate fw-semibold" style="font-size: 0.85rem; color: #0f172a;">@(!string.IsNullOrEmpty(displayEmail) ? displayEmail : displayName)</div>
                                    <div class="mt-1">
                                        @if (userRole == "Admin")
                                        {
                                            <span class="badge" style="background-color: #fff1f2; color: #e11d48; border: 1px solid #fda4af; font-size: 0.68rem; border-radius: 20px; padding: 2px 8px;">
                                                <i class="bi bi-shield-check me-1"></i>ADMINISTRATOR
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background-color: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; font-size: 0.68rem; border-radius: 20px; padding: 2px 8px;">
                                                <i class="bi bi-person-badge me-1"></i>TEACHER
                                            </span>
                                        }
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider my-1" style="border-color: #f1f5f9;"></li>
                            <li>
                                <a href="/Profile" class="dropdown-item d-inline-flex align-items-center gap-2 px-3 py-2" style="font-size: 0.82rem; color: #475569;">
                                    <i class="bi bi-person-gear"></i> Account Profile
                                </a>
                            </li>
                            @if (userRole == "Admin")
                            {
                                <li>
                                    <a href="/Admin" class="dropdown-item d-inline-flex align-items-center gap-2 px-3 py-2" style="font-size: 0.82rem; color: #e11d48;">
                                        <i class="bi bi-shield-lock"></i> Admin Panel
                                    </a>
                                </li>
                            }
                            <li><hr class="dropdown-divider my-1" style="border-color: #f1f5f9;"></li>
                            <li>
                                <a href="/Logout" class="dropdown-item d-inline-flex align-items-center gap-2 px-3 py-2 text-danger" style="font-size: 0.82rem;">
                                    <i class="bi bi-box-arrow-right"></i> Sign out
                                </a>
                            </li>
                        </ul>
                    </div>

                </div>
            </div>
        </header>

        <!-- ================= MAIN LAYOUT WITH SIDEBAR ================= -->
        <div class="app-layout-wrapper">
            
            <!-- Desktop Left Sidebar -->
            <aside class="app-sidebar d-none d-lg-flex" id="mainSidebar">
                <div>
                    <!-- Workspace Header Card -->
                    <div class="d-flex align-items-center gap-2.5 mb-3 p-1">
                        <div class="d-flex align-items-center justify-content-center rounded flex-shrink-0" style="width: 38px; height: 38px; background-color: #eff6ff; color: #2563eb;">
                            <i class="bi bi-mortarboard-fill fs-5"></i>
                        </div>
                        <div class="overflow-hidden sidebar-hide-on-collapse">
                            <div class="fw-bold text-truncate" style="font-size: 0.86rem; color: #0f172a;" title="Teacher Workspace">
                                Teacher Workspace
                            </div>
                            <span style="font-size: 0.78rem; color: #2563eb; font-weight: 500;">
                                Online Learning System
                            </span>
                        </div>
                    </div>

                    <!-- Navigation Group 1: MAIN NAVIGATION -->
                    <div class="sidebar-section-title sidebar-hide-on-collapse">NAVIGATION</div>
                    <nav class="d-flex flex-column">
                        <a href="/Dashboard" class="sidebar-link @IsActive("/Dashboard")" title="Dashboard">
                            <i class="bi bi-grid-1x2"></i>
                            <span class="sidebar-hide-on-collapse">Dashboard</span>
                        </a>
                        <a href="/UploadPdf" class="sidebar-link @IsActive("/UploadPdf")" title="Upload PDF">
                            <i class="bi bi-cloud-arrow-up"></i>
                            <span class="sidebar-hide-on-collapse">Upload PDF</span>
                        </a>
                        <a href="/GenerateQuestionnaire" class="sidebar-link @IsActive("/GenerateQuestionnaire")" title="Generate Exam">
                            <i class="bi bi-magic"></i>
                            <span class="sidebar-hide-on-collapse">Generate Exam</span>
                        </a>
                        <a href="/Questionnaires" class="sidebar-link @IsActive("/Questionnaires")" title="Questionnaires">
                            <i class="bi bi-journal-text"></i>
                            <span class="sidebar-hide-on-collapse">Questionnaires</span>
                        </a>
                        <a href="/GradedSheets" class="sidebar-link @IsActive("/GradedSheets")" title="Graded Sheets">
                            <i class="bi bi-patch-check"></i>
                            <span class="sidebar-hide-on-collapse">Graded Sheets</span>
                        </a>
                        <a href="/Documents" class="sidebar-link @IsActive("/Documents")" title="Documents">
                            <i class="bi bi-folder2-open"></i>
                            <span class="sidebar-hide-on-collapse">Documents</span>
                        </a>
                    </nav>

                    @if (userRole == "Admin")
                    {
                        <!-- Navigation Group 2: ADMINISTRATION -->
                        <div class="sidebar-section-title sidebar-hide-on-collapse">ADMINISTRATION</div>
                        <nav class="d-flex flex-column">
                            <a href="/Admin" class="sidebar-link @IsActive("/Admin")" title="Admin Panel">
                                <i class="bi bi-shield-lock"></i>
                                <span class="sidebar-hide-on-collapse">Admin Panel</span>
                            </a>
                        </nav>
                    }
                </div>

                <!-- Bottom of Sidebar: Collapse Toggle Button (matching |< in screenshot) -->
                <div class="d-flex justify-content-end pt-3 border-top" style="border-color: #f1f5f9 !important;">
                    <button class="btn btn-sm btn-link text-decoration-none p-1 text-muted" id="sidebarCollapseBtn" type="button" title="Toggle Sidebar">
                        <i class="bi bi-chevron-bar-left fs-5" id="sidebarCollapseIcon"></i>
                    </button>
                </div>
            </aside>

            <!-- Mobile Offcanvas Sidebar Drawer -->
            <div class="offcanvas offcanvas-start border-0 shadow-sm" tabindex="-1" id="appSidebarDrawer" aria-labelledby="appSidebarDrawerLabel" style="width: 270px; background-color: #ffffff;">
                <div class="offcanvas-header border-bottom py-3 px-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="d-flex align-items-center justify-content-center rounded" style="width: 26px; height: 26px; border: 1.5px solid #60a5fa; background-color: #eff6ff; color: #2563eb;">
                            <i class="bi bi-bezier2" style="font-size: 0.85rem;"></i>
                        </div>
                        <span style="font-size: 0.95rem; font-weight: 700; color: #0f172a;">NexusOCR</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body p-3">
                    <!-- Workspace Header Card -->
                    <div class="d-flex align-items-center gap-2.5 mb-3 p-1">
                        <div class="d-flex align-items-center justify-content-center rounded flex-shrink-0" style="width: 36px; height: 36px; background-color: #eff6ff; color: #2563eb;">
                            <i class="bi bi-mortarboard-fill fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-bold" style="font-size: 0.84rem; color: #0f172a;">Teacher Workspace</div>
                            <span style="font-size: 0.76rem; color: #2563eb;">Online Learning System</span>
                        </div>
                    </div>

                    <div class="sidebar-section-title">NAVIGATION</div>
                    <nav class="d-flex flex-column">
                        <a href="/Dashboard" class="sidebar-link @IsActive("/Dashboard")">
                            <i class="bi bi-grid-1x2"></i> Dashboard
                        </a>
                        <a href="/UploadPdf" class="sidebar-link @IsActive("/UploadPdf")">
                            <i class="bi bi-cloud-arrow-up"></i> Upload PDF
                        </a>
                        <a href="/GenerateQuestionnaire" class="sidebar-link @IsActive("/GenerateQuestionnaire")">
                            <i class="bi bi-magic"></i> Generate Exam
                        </a>
                        <a href="/Questionnaires" class="sidebar-link @IsActive("/Questionnaires")">
                            <i class="bi bi-journal-text"></i> Questionnaires
                        </a>
                        <a href="/GradedSheets" class="sidebar-link @IsActive("/GradedSheets")">
                            <i class="bi bi-patch-check"></i> Graded Sheets
                        </a>
                        <a href="/Documents" class="sidebar-link @IsActive("/Documents")">
                            <i class="bi bi-folder2-open"></i> Documents
                        </a>
                    </nav>

                    @if (userRole == "Admin")
                    {
                        <div class="sidebar-section-title">ADMINISTRATION</div>
                        <nav class="d-flex flex-column">
                            <a href="/Admin" class="sidebar-link @IsActive("/Admin")">
                                <i class="bi bi-shield-lock"></i> Admin Panel
                            </a>
                        </nav>
                    }
                </div>
            </div>

            <!-- Main Content Area -->
            <main role="main" class="app-content-area">
                @RenderBody()
            </main>

        </div>
    }
    else
    {
        <!-- Auth / Landing Pages Body -->
        <main role="main" style="flex: 1 1 auto;">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Sidebar collapse toggle handler
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.getElementById('mainSidebar');
            const toggleBtn = document.getElementById('sidebarCollapseBtn');
            const toggleIcon = document.getElementById('sidebarCollapseIcon');

            if (sidebar && toggleBtn && toggleIcon) {
                // Restore saved preference
                if (localStorage.getItem('sidebar_collapsed') === 'true') {
                    sidebar.classList.add('collapsed');
                    toggleIcon.classList.replace('bi-chevron-bar-left', 'bi-chevron-bar-right');
                }

                toggleBtn.addEventListener('click', function () {
                    const isCollapsed = sidebar.classList.toggle('collapsed');
                    if (isCollapsed) {
                        toggleIcon.classList.replace('bi-chevron-bar-left', 'bi-chevron-bar-right');
                        localStorage.setItem('sidebar_collapsed', 'true');
                    } else {
                        toggleIcon.classList.replace('bi-chevron-bar-right', 'bi-chevron-bar-left');
                        localStorage.setItem('sidebar_collapsed', 'false');
                    }
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
